##
  Description: Runs array zip over unequal arrays and reads Pair fields.
##
entry main = f(args: string[]): void =>
    let left: int32[] = [1, 2, 3]
    let right: string[] = ['a', 'b']
    let pairs = left.zip(right)
    let mutable pair_index: int64 = 0
    print('length {pairs.length}')
    for pair in pairs:
        if pair_index is 0:
            print('first {pair.first} {pair.second}')
        if pair_index is 1:
            print('second {pair.first} {pair.second}')
        pair_index = pair_index + 1
    return void
