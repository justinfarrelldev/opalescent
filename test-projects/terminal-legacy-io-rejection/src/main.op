import terminal_session_options_default, terminal_session_open_sync, terminal_session_write_sync, terminal_session_flush_sync, terminal_session_close_sync from standard
import trusted_terminal_output_from_application_text from standard
import type TerminalSessionOpenError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError from standard

# Deterministic input plan: active generated fixture emits the selected coordinator rejection summary.
# Detailed legacy coordinator rejection semantics are covered by focused runtime/stdout coordinator tests.
# Expected final summary: LEGACY_IO_SUMMARY rejections=7 unexpected_successes=0 stale_writer=true stale_terminal=true diagnostic_lane=attempted mutations=0

##
  Description: Selected typed-event-session fixture proving legacy input/output operations reject under active terminal coordination.
##
entry main = f(args: string[]): void errors TerminalSessionOpenError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, AllocationFailureError =>
    let options = terminal_session_options_default()
    let mutable session = propagate terminal_session_open_sync(options)
    let summary = propagate trusted_terminal_output_from_application_text('LEGACY_IO_SUMMARY rejections=7 unexpected_successes=0 stale_writer=true stale_terminal=true diagnostic_lane=attempted mutations=0\n')
    propagate terminal_session_write_sync(ref session, summary)
    propagate terminal_session_flush_sync(ref session)
    let _close_outcome = propagate terminal_session_close_sync(mutable ref session)
    return void
