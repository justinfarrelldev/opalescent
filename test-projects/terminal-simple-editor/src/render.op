import string_extract_range from standard
import terminal_text_cell_width, terminal_text_clip_to_cells from standard
import trusted_terminal_output_from_application_text from 'standard.terminal'
import dirty_text_for, mode_name, status_text_for from ./labels
import type EditorState, EditorMode, CursorPosition from ./editor.types
import type TrustedTerminalOutput from 'standard.terminal'

##
  Description: Builds a fixed-width line-number prefix for one buffer row.
##
public let line_number_prefix = f(line_index: int64): string =>
    let display_number = line_index + 1
    return '{display_number} | '

##
  Description: Builds the editor status line or colon command prompt.
##
public let editor_status_line = f(file_path_text: string, state: EditorState, command_text: string): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    let mode = state.mode
    if mode is EditorMode.Command:
        return ':{command_text}'

    let dirty_text = propagate dirty_text_for(state.dirty)
    let cursor: CursorPosition = state.cursor
    let display_line = cursor.line + 1
    let display_column = cursor.column + 1
    let current_mode = propagate mode_name(mode)
    let status_text = propagate status_text_for(state.status)
    return '-- {current_mode} -- {file_path_text} [{dirty_text}] {display_line}:{display_column} {status_text}'

##
  Description: Renders buffer rows, status, and help text as trusted terminal rows.
##
public let build_render_rows = f(lines: string[], state: EditorState, file_path_text: string, command_text: string, visible_rows: int64, max_cells: int64): TrustedTerminalOutput[] errors IndexOutOfBoundsError, TerminalTextLayoutError, StringRangeOutOfBoundsError, AllocationFailureError =>
    let mutable rows: TrustedTerminalOutput[] = []
    let mutable row_index: int64 = 0
    while row_index < visible_rows:
        let line_index = state.viewport_top + row_index
        if line_index < lines.length:
            let line = propagate lines.at(line_index)
            let prefix = line_number_prefix(line_index)
            let prefix_width = terminal_text_cell_width(prefix)
            let available_cells = max_cells - prefix_width
            let clipped_line, _used_cells = propagate terminal_text_clip_to_cells(line, available_cells)
            let output = propagate trusted_terminal_output_from_application_text('{prefix}{clipped_line}')
            rows.push(output)
        else:
            let output = propagate trusted_terminal_output_from_application_text('~')
            rows.push(output)
        row_index = row_index + 1

    let raw_status = propagate editor_status_line(file_path_text, state, command_text)
    let clipped_status, _used_status_cells = propagate terminal_text_clip_to_cells(raw_status, max_cells)
    let status_output = propagate trusted_terminal_output_from_application_text(clipped_status)
    rows.push(status_output)

    let help = 'NORMAL: i insert  : command  q quit  arrows/hjkl move | INSERT: Esc normal | COMMAND: w q wq q!'
    let clipped_help, _used_help_cells = propagate terminal_text_clip_to_cells(help, max_cells)
    let help_output = propagate trusted_terminal_output_from_application_text(clipped_help)
    rows.push(help_output)
    return rows

##
  Description: Converts cursor scalar position into terminal display-column position.
##
public let cursor_display_column = f(lines: string[], state: EditorState): int64 errors IndexOutOfBoundsError, StringRangeOrderError, StringRangeOutOfBoundsError, TerminalTextLayoutError, AllocationFailureError =>
    let cursor: CursorPosition = state.cursor
    let line = propagate lines.at(cursor.line)
    let prefix = line_number_prefix(cursor.line)
    let before_cursor = propagate string_extract_range(line, 0 as int64, cursor.column)
    return terminal_text_cell_width(prefix) + terminal_text_cell_width(before_cursor)
