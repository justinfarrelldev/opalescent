import type EditorMode, EditorCommand, EditorStatus, EditorTermination from ./editor.types
import copy_text from ./text_helpers

##
  Description: Returns a display label for the active editor mode.
##
public let mode_name = f(mode: EditorMode): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    if mode is EditorMode.Insert:
        return propagate copy_text('INSERT')
    if mode is EditorMode.Command:
        return propagate copy_text('COMMAND')
    return propagate copy_text('NORMAL')

##
  Description: Returns the colon-command text for the compact command state.
##
public let command_text_for = f(command: EditorCommand): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    if command is EditorCommand.Write:
        return propagate copy_text('w')
    if command is EditorCommand.Quit:
        return propagate copy_text('q')
    if command is EditorCommand.WriteQuit:
        return propagate copy_text('wq')
    if command is EditorCommand.ForceQuit:
        return propagate copy_text('q!')
    if command is EditorCommand.Invalid into invalid:
        return propagate copy_text(invalid.text)
    return propagate copy_text('')

##
  Description: Returns a display label for the current editor status.
##
public let status_text_for = f(status: EditorStatus): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    if status is EditorStatus.NewEmpty:
        return propagate copy_text('new empty buffer')
    if status is EditorStatus.Opened into opened:
        return 'opened {opened.path}'
    if status is EditorStatus.NormalMode:
        return propagate copy_text('normal mode')
    if status is EditorStatus.InsertMode:
        return propagate copy_text('insert mode')
    if status is EditorStatus.CommandMode:
        return propagate copy_text('command mode')
    if status is EditorStatus.Moved:
        return propagate copy_text('moved')
    if status is EditorStatus.LineStart:
        return propagate copy_text('line start')
    if status is EditorStatus.LineEnd:
        return propagate copy_text('line end')
    if status is EditorStatus.InsertedText:
        return propagate copy_text('inserted text')
    if status is EditorStatus.LineSplit:
        return propagate copy_text('line split')
    if status is EditorStatus.Deleted:
        return propagate copy_text('deleted')
    if status is EditorStatus.Written into written:
        return 'written {written.path}'
    if status is EditorStatus.Ok:
        return propagate copy_text('ok')
    if status is EditorStatus.UnsavedChanges:
        return propagate copy_text('unsaved changes: use :q! or :wq')
    if status is EditorStatus.InvalidKey into invalid:
        return 'invalid key {invalid.key}'
    if status is EditorStatus.EnterInsertOnly:
        return propagate copy_text('enter opens lines only in insert mode')
    if status is EditorStatus.Resized:
        return propagate copy_text('terminal resized')
    if status is EditorStatus.Cancelled:
        return propagate copy_text('cancelled')
    if status is EditorStatus.EndOfInput:
        return propagate copy_text('end of input')
    if status is EditorStatus.QuitWithoutSaving:
        return propagate copy_text('quit without saving')
    if status is EditorStatus.FileEnd:
        return propagate copy_text('file end')
    if status is EditorStatus.InvalidCommand into invalid_command:
        return 'not an editor command: {invalid_command.text}'
    return propagate copy_text('ok')

##
  Description: Returns a display label for why the editor stopped.
##
public let termination_text_for = f(termination: EditorTermination): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    if termination is EditorTermination.NormalQ:
        return propagate copy_text('normal-q')
    if termination is EditorTermination.CommandQ:
        return propagate copy_text('command-q')
    if termination is EditorTermination.CommandWq:
        return propagate copy_text('command-wq')
    if termination is EditorTermination.CommandQBang:
        return propagate copy_text('command-q-bang')
    if termination is EditorTermination.Cancelled:
        return propagate copy_text('cancelled')
    if termination is EditorTermination.EndOfInput:
        return propagate copy_text('end-of-input')
    return propagate copy_text('running')

##
  Description: Returns a display label for whether the buffer has unsaved edits.
##
public let dirty_text_for = f(dirty: boolean): string errors StringRangeOutOfBoundsError, AllocationFailureError =>
    if dirty:
        return propagate copy_text('dirty')
    return propagate copy_text('clean')
