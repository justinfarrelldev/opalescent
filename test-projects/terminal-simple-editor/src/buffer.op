import path_from, write_text_atomic_sync, string_join, string_length from standard
import string_insert_at, string_delete_range, string_extract_range from standard
import type CursorPosition from ./editor.types

##
  Description: Ensures a text buffer always has at least one editable line.
##
public let ensure_nonempty_lines = f(lines: string[]): string[] =>
    let mutable result: string[] = lines
    if result.length is 0:
        result.push('')
    return result

##
  Description: Constructs a cursor position value.
##
public let buffer_cursor = f(line: int64, column: int64): CursorPosition =>
    return new CursorPosition:
        line: line
        column: column

##
  Description: Returns the Unicode scalar length of a line in the buffer.
##
public let line_length_at = f(lines: string[], line_index: int64): int64 errors IndexOutOfBoundsError =>
    let line = propagate lines.at(line_index)
    return string_length(line)

##
  Description: Clamps a requested cursor column to the selected line length.
##
public let clamp_column_to_line = f(lines: string[], line_index: int64, column: int64): int64 errors IndexOutOfBoundsError =>
    let length = propagate line_length_at(lines, line_index)
    if column < 0:
        return 0
    if column > length:
        return length
    return column

##
  Description: Clamps a cursor position to the selected line's valid column range.
##
public let clamp_cursor_to_line = f(lines: string[], cursor: CursorPosition): CursorPosition errors IndexOutOfBoundsError =>
    let clamped_column = propagate clamp_column_to_line(lines, cursor.line, cursor.column)
    return buffer_cursor(cursor.line, clamped_column)

##
  Description: Scrolls the viewport enough to keep the cursor visible.
##
public let update_viewport = f(cursor_line: int64, viewport_top: int64, visible_rows: int64): int64 =>
    if cursor_line < viewport_top:
        return cursor_line
    if cursor_line >= viewport_top + visible_rows:
        return cursor_line - visible_rows + 1
    return viewport_top

##
  Description: Inserts text at the current cursor position.
##
public let insert_text_at_cursor = f(lines: string[], cursor: CursorPosition, text: string): updated_lines: string[], updated_cursor: CursorPosition errors IndexOutOfBoundsError, StringRangeOutOfBoundsError, AllocationFailureError =>
    let line = propagate lines.at(cursor.line)
    let updated_line = propagate string_insert_at(line, cursor.column, text)
    let mutable changed: string[] = lines
    changed[cursor.line] = updated_line
    return updated_lines: changed, updated_cursor: buffer_cursor(cursor.line, cursor.column + string_length(text))

##
  Description: Splits the current line at the cursor position.
##
public let split_line_at_cursor = f(lines: string[], cursor: CursorPosition): updated_lines: string[], updated_cursor: CursorPosition errors IndexOutOfBoundsError, StringRangeOrderError, StringRangeOutOfBoundsError, AllocationFailureError =>
    let line = propagate lines.at(cursor.line)
    let before = propagate string_extract_range(line, 0 as int64, cursor.column)
    let after = propagate string_extract_range(line, cursor.column, string_length(line))
    let mutable changed: string[] = lines
    changed[cursor.line] = before
    let inserted = propagate changed.insert(cursor.line + 1, after)
    return updated_lines: inserted, updated_cursor: buffer_cursor(cursor.line + 1, 0)

##
  Description: Deletes before the cursor or joins with the previous line.
##
public let backspace_at_cursor = f(lines: string[], cursor: CursorPosition): updated_lines: string[], updated_cursor: CursorPosition errors IndexOutOfBoundsError, StringRangeOrderError, StringRangeOutOfBoundsError, AllocationFailureError =>
    if cursor.column > 0:
        let line = propagate lines.at(cursor.line)
        let updated_line = propagate string_delete_range(line, cursor.column - 1, cursor.column)
        let mutable changed: string[] = lines
        changed[cursor.line] = updated_line
        return updated_lines: changed, updated_cursor: buffer_cursor(cursor.line, cursor.column - 1)

    if cursor.line > 0:
        let previous = propagate lines.at(cursor.line - 1)
        let current = propagate lines.at(cursor.line)
        let joined = '{previous}{current}'
        let mutable changed: string[] = lines
        changed[cursor.line - 1] = joined
        let updated, _removed = propagate changed.remove_at(cursor.line)
        return updated_lines: updated, updated_cursor: buffer_cursor(cursor.line - 1, string_length(previous))

    return updated_lines: lines, updated_cursor: cursor

##
  Description: Deletes under the cursor or joins with the next line.
##
public let delete_at_cursor = f(lines: string[], cursor: CursorPosition): updated_lines: string[], updated_cursor: CursorPosition errors IndexOutOfBoundsError, StringRangeOrderError, StringRangeOutOfBoundsError, AllocationFailureError =>
    let line = propagate lines.at(cursor.line)
    if cursor.column < string_length(line):
        let updated_line = propagate string_delete_range(line, cursor.column, cursor.column + 1)
        let mutable changed: string[] = lines
        changed[cursor.line] = updated_line
        return updated_lines: changed, updated_cursor: cursor

    if cursor.line + 1 < lines.length:
        let next_line = propagate lines.at(cursor.line + 1)
        let joined = '{line}{next_line}'
        let mutable changed: string[] = lines
        changed[cursor.line] = joined
        let updated, _removed = propagate changed.remove_at(cursor.line + 1)
        return updated_lines: updated, updated_cursor: cursor

    return updated_lines: lines, updated_cursor: cursor

##
  Description: Writes all lines with newline separators using an atomic filesystem write.
##
public let save_lines = f(file_path_text: string, lines: string[]): void errors FilesystemWriteError, AllocationFailureError =>
    let path = path_from(file_path_text)
    let text = propagate string_join(lines, '\n')
    propagate write_text_atomic_sync(path, text)
    return void

##
  Description: Moves the cursor left, wrapping to the previous line when needed.
##
public let move_left = f(lines: string[], cursor: CursorPosition): CursorPosition errors IndexOutOfBoundsError =>
    if cursor.column > 0:
        return buffer_cursor(cursor.line, cursor.column - 1)
    if cursor.line > 0:
        let previous_length = propagate line_length_at(lines, cursor.line - 1)
        return buffer_cursor(cursor.line - 1, previous_length)
    return cursor

##
  Description: Moves the cursor right, wrapping to the next line when needed.
##
public let move_right = f(lines: string[], cursor: CursorPosition): CursorPosition errors IndexOutOfBoundsError =>
    let current_length = propagate line_length_at(lines, cursor.line)
    if cursor.column < current_length:
        return buffer_cursor(cursor.line, cursor.column + 1)
    if cursor.line + 1 < lines.length:
        return buffer_cursor(cursor.line + 1, 0)
    return cursor

##
  Description: Moves the cursor up and clamps the column to the destination line.
##
public let move_up = f(lines: string[], cursor: CursorPosition): CursorPosition errors IndexOutOfBoundsError =>
    if cursor.line > 0:
        let new_line = cursor.line - 1
        let new_column = propagate clamp_column_to_line(lines, new_line, cursor.column)
        return buffer_cursor(new_line, new_column)
    return cursor

##
  Description: Moves the cursor down and clamps the column to the destination line.
##
public let move_down = f(lines: string[], cursor: CursorPosition): CursorPosition errors IndexOutOfBoundsError =>
    if cursor.line + 1 < lines.length:
        let new_line = cursor.line + 1
        let new_column = propagate clamp_column_to_line(lines, new_line, cursor.column)
        return buffer_cursor(new_line, new_column)
    return cursor
