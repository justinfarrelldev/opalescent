import terminal_session_options_default, terminal_session_open_sync from standard.terminal
import terminal_session_read_event_sync from standard.terminal
import terminal_session_flush_sync, terminal_session_write_sync from standard.terminal
import terminal_session_clear_screen_sync, terminal_session_move_cursor_sync from standard.terminal
import terminal_session_bell_sync from standard.terminal
import cancellation_source_new, cancellation_token from standard.system
import path_from, path_exists_sync, read_lines_sync, string_length from standard
import int64_to_int32 from standard.numeric
import ensure_nonempty_lines, clamp_cursor_to_line, update_viewport from ./buffer
import build_render_rows, cursor_display_column, cursor_screen_column from ./render
import apply_text_input, apply_named_key from ./input
import initial_editor_state, with_cursor_and_viewport, with_status, with_stopped_status from ./state
import type EditorMode, EditorStatus, EditorTermination, CursorPosition from ./editor.types
import type TerminalWait, TerminalInputEvent, TerminalLogicalKey from standard.terminal
import type TerminalSessionOpenError, TerminalSessionReadError from standard.terminal
import type TerminalSessionWriteError, TerminalSessionStateError from standard.terminal
import type TerminalSessionRestoreError from standard.terminal

##
  Description: Runs a tiny modal terminal editor with normal, insert, and command modes.
##
entry main = f(args: string[]): void errors
    AllocationFailureError,
    FileNotFoundError,
    IndexOutOfBoundsError,
    InvalidCursorPositionError,
    IntegerRangeError,
    InvalidPathError,
    InvalidUtf8Error,
    IsADirectoryError,
    OffsetOutOfRangeError,
    PermissionDeniedError,
    ReadFailureError,
    StringRangeOrderError,
    StringRangeOutOfBoundsError,
    TerminalSessionOpenError,
    TerminalSessionReadError,
    TerminalSessionRestoreError,
    TerminalSessionStateError,
    TerminalSessionWriteError,
    TerminalTextLayoutError
=>
    let file_path_text: string = guard args.at(1) into arg_path: string else
        'test-projects/terminal-simple-editor/workspace/untitled.txt'
    let opened = args.length > 1
    let mutable lines: string[] = []
    let mutable loaded = false
    if opened:
        let loaded_path = path_from(file_path_text)
        let path_exists = propagate path_exists_sync(loaded_path)
        if path_exists:
            lines = ensure_nonempty_lines(propagate read_lines_sync(loaded_path))
            loaded = true
        else:
            lines.push('')
    else:
        lines.push('')
    let source = propagate cancellation_source_new()
    let token = cancellation_token(ref source)
    let options = terminal_session_options_default()
    let visible_rows: int64 = 10
    let max_cells: int64 = 80
    let mutable state = initial_editor_state(file_path_text, opened, loaded)
    using session = propagate terminal_session_open_sync(options):
        while state.running:
            let clamped_cursor: CursorPosition = propagate clamp_cursor_to_line(lines, state.cursor)
            let next_viewport = update_viewport(
                clamped_cursor.line,
                state.viewport_top,
                visible_rows
            )
            state = with_cursor_and_viewport(state, clamped_cursor, next_viewport)
            let command_text = state.command_text
            let rows = propagate build_render_rows(
                lines,
                state,
                file_path_text,
                command_text,
                visible_rows,
                max_cells
            )
            propagate terminal_session_clear_screen_sync(mutable ref session)
            let mutable render_row_index: int64 = 0
            while render_row_index < rows.length:
                let row_output = propagate rows.at(render_row_index)
                propagate terminal_session_move_cursor_sync(
                    mutable ref session,
                    propagate int64_to_int32(render_row_index + 1),
                    propagate int64_to_int32(1)
                )
                propagate terminal_session_write_sync(ref session, row_output)
                render_row_index = render_row_index + 1
            let mode = state.mode
            if mode is EditorMode.Command:
                let command_cursor_column = cursor_screen_column(
                    string_length(command_text) + 1,
                    max_cells
                )
                propagate terminal_session_move_cursor_sync(
                    mutable ref session,
                    propagate int64_to_int32(visible_rows + 1),
                    propagate int64_to_int32(command_cursor_column)
                )
            else:
                let display_column = propagate cursor_display_column(lines, state)
                let screen_column = cursor_screen_column(display_column, max_cells)
                let cursor: CursorPosition = state.cursor
                propagate terminal_session_move_cursor_sync(
                    mutable ref session,
                    propagate int64_to_int32(cursor.line - state.viewport_top + 1),
                    propagate int64_to_int32(screen_column)
                )
            propagate terminal_session_flush_sync(ref session)
            let event = propagate terminal_session_read_event_sync(
                mutable ref session,
                new TerminalWait.Forever,
                token
            )
            if event is TerminalInputEvent.TextInput into text_event:
                let updated_lines: text_lines, transition: text_transition =
                    propagate apply_text_input(lines, state, text_event.text)
                lines = text_lines
                state = text_transition.state
                if text_transition.should_bell:
                    guard terminal_session_bell_sync(mutable ref session) else bell_err =>
                        let bell_status: EditorStatus = new EditorStatus.BellFailed:
                            message: 'bell failed: {bell_err}'
                        state = with_status(state, bell_status)
                        continue
            if event is TerminalInputEvent.Key into key_event:
                let logical = key_event.key
                if logical is TerminalLogicalKey.Text into text_key:
                    let updated_lines: key_text_lines, transition: key_text_transition =
                        propagate apply_text_input(lines, state, text_key.logical_text)
                    lines = key_text_lines
                    state = key_text_transition.state
                    if key_text_transition.should_bell:
                        guard terminal_session_bell_sync(mutable ref session) else bell_err =>
                            let bell_status: EditorStatus = new EditorStatus.BellFailed:
                                message: 'bell failed: {bell_err}'
                            state = with_status(state, bell_status)
                            continue
                if logical is TerminalLogicalKey.Named into named:
                    let updated_lines: named_lines, transition: named_transition =
                        propagate apply_named_key(file_path_text, lines, state, named.key)
                    lines = named_lines
                    state = named_transition.state
                    if named_transition.should_bell:
                        guard terminal_session_bell_sync(mutable ref session) else bell_err =>
                            let bell_status: EditorStatus = new EditorStatus.BellFailed:
                                message: 'bell failed: {bell_err}'
                            state = with_status(state, bell_status)
                            continue
            if event is TerminalInputEvent.Resize:
                state = with_status(state, new EditorStatus.Resized)
            if event is TerminalInputEvent.Cancelled:
                state = with_stopped_status(
                    state,
                    new EditorStatus.Cancelled,
                    new EditorTermination.Cancelled
                )
            if event is TerminalInputEvent.EndOfInput:
                state = with_stopped_status(
                    state,
                    new EditorStatus.EndOfInput,
                    new EditorTermination.EndOfInput
                )
        propagate terminal_session_move_cursor_sync(
            mutable ref session,
            propagate int64_to_int32(visible_rows + 3),
            propagate int64_to_int32(1)
        )
        propagate terminal_session_flush_sync(ref session)
    return void
