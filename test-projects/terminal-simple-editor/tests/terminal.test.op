import temporary_directory_create, temporary_directory_file, temporary_directory_remove from standard.testing
import application_executable, terminal_process_launch, terminal_process_send_text, terminal_process_send_key from standard.testing
import terminal_process_row, terminal_process_exited, terminal_process_exit_code, terminal_process_transcript, terminal_process_stop from standard.testing
import path_from, path_parent_directory, path_to_string, write_text_sync, read_text_sync from standard
import type TemporaryDirectory, TerminalProcess from standard.testing

world TerminalWorkspace:
    setup: f(): TemporaryDirectory errors inferred =>
        let workspace = propagate temporary_directory_create()
        let filename = temporary_directory_file(ref workspace, 'document.txt')
        propagate write_text_sync(path_from(filename), 'café\n!')
        return workspace
    cleanup:
        f(mutable ref workspace: TemporaryDirectory): void errors inferred =>
            propagate temporary_directory_remove(mutable ref workspace)
            return void

world EditorTerminal:
    worlds: TerminalWorkspace
    setup: f(ref workspace: TerminalWorkspace): TerminalProcess errors inferred =>
        let filename = temporary_directory_file(ref workspace.state, 'document.txt')
        let directory = path_to_string(path_parent_directory(path_from(filename)))
        return propagate terminal_process_launch(application_executable(), filename, directory, 80, 24)
    cleanup:
        f(mutable ref process: TerminalProcess): void errors inferred =>
            propagate terminal_process_stop(mutable ref process)
            return void

scenario saving and quitting the production editor:
    kind: end_to_end
    worlds: TerminalWorkspace, EditorTerminal
    after each test:
        f(ref editor: EditorTerminal): void =>
            print(terminal_process_transcript(ref editor.state))
            return void

    it should save actual typed text and exit without requiring a final frame:
        f(ref workspace: TerminalWorkspace, mutable ref editor: EditorTerminal): void errors inferred =>
            expect eventually terminal_process_row(ref editor.state, 10) to contain 'NORMAL' within 3 seconds
            propagate terminal_process_send_text(mutable ref editor.state, 'i')
            expect eventually terminal_process_row(ref editor.state, 10) to contain 'INSERT' within 3 seconds
            propagate terminal_process_send_text(mutable ref editor.state, 'Reviewed ')
            propagate terminal_process_send_key(mutable ref editor.state, 'Escape')
            expect eventually terminal_process_row(ref editor.state, 10) to contain 'NORMAL' within 3 seconds
            propagate terminal_process_send_text(mutable ref editor.state, ':')
            expect eventually terminal_process_row(ref editor.state, 10) to start with ':' within 3 seconds
            propagate terminal_process_send_text(mutable ref editor.state, 'wq')
            propagate terminal_process_send_key(mutable ref editor.state, 'Enter')
            expect eventually terminal_process_exited(ref editor.state) to be true within 3 seconds
            expect terminal_process_exit_code(ref editor.state) to be 0
            let filename = temporary_directory_file(ref workspace.state, 'document.txt')
            let contents = propagate read_text_sync(path_from(filename))
            expect contents to be 'Reviewed café\n!'
            return void
