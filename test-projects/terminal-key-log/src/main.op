import terminal_session_options_default, terminal_session_open_sync, terminal_session_read_event_sync, terminal_session_write_sync, terminal_session_flush_sync, terminal_session_close_sync from standard
import trusted_terminal_output_from_application_text, cancellation_source_new, cancellation_token from standard

##
  Description: Selected typed-event-session fixture for a bounded typed-event key log with deterministic summary output.
##
entry main = f(args: string[]): void errors TerminalSessionOpenError, TerminalSessionReadError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, AllocationFailureError =>
    let source = propagate cancellation_source_new()
    let token = cancellation_token(source)
    let options = terminal_session_options_default()
    let mutable session = propagate terminal_session_open_sync(options)

    let mutable key_count: int64 = 0
    let mutable timeout_count: int64 = 0
    let mutable cancellation_count: int64 = 0
    let mutable last_key = 'none'
    let mutable termination = 'budget-exhausted'
    let mutable running = true
    let mutable reads: int64 = 0

    while running and reads < 8:
        let event = propagate terminal_session_read_event_sync(session, new TerminalWait.Poll, token)
        reads = reads + 1
        if event is TerminalInputEvent.Key:
            key_count = key_count + 1
            if event.key is TerminalLogicalKey.Text:
                last_key = 'text'
            if event.key is TerminalLogicalKey.Control:
                last_key = 'control'
            if event.key is TerminalLogicalKey.Named:
                last_key = 'named'
            if event.key is TerminalLogicalKey.Function:
                last_key = 'function'
            if event.modifiers.shift:
                last_key = '{last_key}+shift'
            if event.modifiers.control:
                last_key = '{last_key}+control'
            if event.modifiers.alt:
                last_key = '{last_key}+alt'
        if event is TerminalInputEvent.TimedOut:
            timeout_count = timeout_count + 1
        if event is TerminalInputEvent.Cancelled:
            cancellation_count = cancellation_count + 1
            termination = 'cancelled'
            running = false
        if event is TerminalInputEvent.EndOfInput:
            termination = 'end-of-input'
            running = false

    let summary = propagate trusted_terminal_output_from_application_text('KEY_LOG_SUMMARY keys={key_count} last_key={last_key} timeouts={timeout_count} cancellations={cancellation_count} termination={termination}\n')
    propagate terminal_session_write_sync(session, summary)
    propagate terminal_session_flush_sync(session)
    let close_outcome = propagate terminal_session_close_sync(session)
    return void
