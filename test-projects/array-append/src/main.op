import append from standard

##
  Description: Runs the append red fixture for array growth behavior.
##
entry main = f(args: string[]): void errors IndexOutOfBoundsError =>
    let original: int32[] = [1, 2]
    let next_value: int32 = 3
    let grown = append(original, next_value)
    print('original length {original.length}')
    print('grown length {grown.length}')
    print('grown values {propagate grown.at(0)} {propagate grown.at(1)} {propagate grown.at(2)}')
    return void
