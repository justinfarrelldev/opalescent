import terminal_session_open_sync, terminal_session_close_sync from standard
import terminal_session_options_default, terminal_session_options_with_feature_policy, terminal_session_options_with_resource_limits, terminal_session_options_validate from standard
import safe_terminal_diagnostic_format, safe_terminal_diagnostic_collection_format from standard
import terminal_diagnostic_backend, terminal_diagnostic_operation, terminal_diagnostic_stage, terminal_diagnostic_coordinator_state, terminal_diagnostic_session_state, terminal_diagnostic_os_code, terminal_diagnostic_detail, terminal_diagnostic_retryability, terminal_diagnostic_was_truncated from standard
import terminal_diagnostics_length, terminal_diagnostics_at, terminal_diagnostics_retained_count, terminal_diagnostics_omitted_count, terminal_diagnostics_retained_bytes, terminal_diagnostics_omitted_bytes, terminal_diagnostics_was_truncated from standard
import type TerminalSessionOptions, TerminalSessionFeaturePolicy, TerminalSessionResourceLimits, TerminalMouseTracking, TerminalDiagnostic, TerminalDiagnosticCollection, TerminalInvalidOptions from standard

# Deterministic input plan: no terminal input events are consumed; this fixture validates options and observes deterministic terminal diagnostics before any live session exists.
# Deterministic fault plan: invalid resource limits refine TerminalSessionOptionsError.InvalidOptions, strict feature open refines TerminalSessionOpenError.UnsupportedFeature, and default open refines TerminalSessionOpenError.RollbackFailed diagnostics collection.
# Expected final summary: DIAGNOSTICS_INSPECTOR_SUMMARY invalid_options=1 single_diagnostics=1 collections=1 formatted=2 authority=structured_fields session_opened=false

let inspect_invalid_options = f(invalid_options: TerminalInvalidOptions): void =>
    if invalid_options is TerminalInvalidOptions.RetainedCapacityTooSmall into capacity:
        let required_bytes = capacity.required_bytes
        let configured_bytes = capacity.configured_bytes
    if invalid_options is TerminalInvalidOptions.CorrelatedGroupTooLarge into correlated:
        let required_events = correlated.required_events
        let configured_events = correlated.configured_events
    return void

let inspect_structured_diagnostic = f(diagnostic: TerminalDiagnostic): void errors AllocationFailureError =>
    let backend = terminal_diagnostic_backend(diagnostic)
    let operation = terminal_diagnostic_operation(diagnostic)
    let stage = terminal_diagnostic_stage(diagnostic)
    let coordinator_state = terminal_diagnostic_coordinator_state(diagnostic)
    let session_state = terminal_diagnostic_session_state(diagnostic)
    let os_code = terminal_diagnostic_os_code(diagnostic)
    let detail = terminal_diagnostic_detail(diagnostic)
    let retryability = terminal_diagnostic_retryability(diagnostic)
    let was_truncated = terminal_diagnostic_was_truncated(diagnostic)
    # Formatting is deliberately last; structured fields above are the authority.
    let safe_output = propagate safe_terminal_diagnostic_format(diagnostic)
    return void

let inspect_diagnostic_collection = f(diagnostics: TerminalDiagnosticCollection): void errors IndexOutOfBoundsError, AllocationFailureError =>
    let retained_count = terminal_diagnostics_retained_count(diagnostics)
    let omitted_count = terminal_diagnostics_omitted_count(diagnostics)
    let retained_bytes = terminal_diagnostics_retained_bytes(diagnostics)
    let omitted_bytes = terminal_diagnostics_omitted_bytes(diagnostics)
    let collection_truncated = terminal_diagnostics_was_truncated(diagnostics)
    let mutable index: int64 = 0
    while index < terminal_diagnostics_length(diagnostics):
        propagate inspect_structured_diagnostic(propagate terminal_diagnostics_at(diagnostics, index))
        index = index + 1
    let safe_collection_output = propagate safe_terminal_diagnostic_collection_format(diagnostics)
    return void

let inspect_invalid_resource_options_sync = f(): boolean errors AllocationFailureError =>
    let limits = new TerminalSessionResourceLimits:
        input_sequence_timeout: 25 as TerminalInputSequenceTimeoutMilliseconds
        maximum_committed_text_bytes: 4096 as TerminalCommittedTextByteLimit
        maximum_composition_preedit_bytes: 4096 as TerminalCompositionPreeditByteLimit
        maximum_paste_chunk_bytes: 4096 as TerminalPasteChunkByteLimit
        maximum_unknown_chunk_bytes: 1024 as TerminalUnknownByteChunkLimit
        maximum_pending_sequence_bytes: 1024 as TerminalPendingSequenceByteLimit
        maximum_retained_events: 8 as TerminalRetainedEventLimit
        maximum_retained_bytes: 4096 as TerminalRetainedByteLimit
        maximum_correlated_events: 64 as TerminalCorrelatedEventLimit
        maximum_correlated_bytes: 65536 as TerminalCorrelatedByteLimit
        maximum_diagnostics: 16 as TerminalDiagnosticCountLimit
        maximum_diagnostic_bytes: 65536 as TerminalDiagnosticCollectionByteLimit
    let candidate = propagate terminal_session_options_with_resource_limits(terminal_session_options_default(), limits)
    guard terminal_session_options_validate(candidate) into valid_options else options_error =>
        if options_error is TerminalSessionOptionsError.InvalidOptions into invalid:
            inspect_invalid_options(invalid.invalid_options)
            return true
        return false
    return false

let strict_feature_options = f(): TerminalSessionOptions errors TerminalSessionOptionsError, AllocationFailureError =>
    let policy = new TerminalSessionFeaturePolicy:
        use_alternate_screen: false
        hide_cursor: false
        enable_bracketed_paste: false
        require_trusted_paste_framing: true
        enable_enhanced_key_identity: true
        enable_focus_events: true
        mouse_tracking: new TerminalMouseTracking.AllMotion
        capture_control_keys: true
        require_requested_features: true
    return propagate terminal_session_options_validate(propagate terminal_session_options_with_feature_policy(terminal_session_options_default(), policy))

let inspect_unsupported_open_sync = f(options: TerminalSessionOptions): boolean errors TerminalSessionOpenError, TerminalSessionRestoreError, IndexOutOfBoundsError, AllocationFailureError =>
    guard terminal_session_open_sync(options) into session else open_error =>
        if open_error is TerminalSessionOpenError.UnsupportedFeature into unsupported:
            propagate inspect_structured_diagnostic(unsupported.diagnostic) cause open_error
            return true
        if open_error is TerminalSessionOpenError.InvalidOptions into invalid:
            inspect_invalid_options(invalid.invalid_options)
            propagate inspect_structured_diagnostic(invalid.diagnostic) cause open_error
            return true
        propagate open_error
    let close_outcome = propagate terminal_session_close_sync(session)
    return false

let inspect_collection_open_failure_sync = f(options: TerminalSessionOptions): boolean errors TerminalSessionOpenError, TerminalSessionRestoreError, IndexOutOfBoundsError, AllocationFailureError =>
    guard terminal_session_open_sync(options) into session else open_error =>
        if open_error is TerminalSessionOpenError.RollbackFailed into failed:
            propagate inspect_diagnostic_collection(failed.diagnostics) cause open_error
            return true
        if open_error is TerminalSessionOpenError.RecoveryPending into pending:
            propagate inspect_structured_diagnostic(pending.diagnostic) cause open_error
            return true
        propagate open_error
    let close_outcome = propagate terminal_session_close_sync(session)
    return false

##
  Description: Proposal RED fixture inspecting structured terminal diagnostics before safe formatting output.
##
entry main = f(args: string[]): void errors TerminalSessionOptionsError, TerminalSessionOpenError, TerminalSessionRestoreError, IndexOutOfBoundsError, AllocationFailureError =>
    let mutable invalid_options_count: int64 = 0
    let mutable single_diagnostics: int64 = 0
    let mutable collections: int64 = 0
    let mutable session_opened = false

    if propagate inspect_invalid_resource_options_sync():
        invalid_options_count = invalid_options_count + 1

    let strict_options = propagate strict_feature_options()
    if propagate inspect_unsupported_open_sync(strict_options):
        single_diagnostics = single_diagnostics + 1
    else:
        session_opened = true

    if propagate inspect_collection_open_failure_sync(terminal_session_options_default()):
        collections = collections + 1
    else:
        session_opened = true

    print('DIAGNOSTICS_INSPECTOR_SUMMARY invalid_options={invalid_options_count} single_diagnostics={single_diagnostics} collections={collections} formatted=2 authority=structured_fields session_opened={session_opened}')
    return void
