import operation, text, values from ./io

##
    Description: Preserve the canonical importing module.
##
public let apply = f(value: int64): int64 =>
    return operation(value)

##
    Description: A managed observation boundary.
##
public let apply_text = f(ref value: string): string =>
    return text(ref value)

##
    Description: A nested array observation boundary.
##
public let apply_values = f(ref input: int64[][]): void =>
    values(ref input)
    return void
