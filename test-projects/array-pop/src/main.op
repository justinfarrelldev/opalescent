##
  Description: Runs the pop red fixture for mutable array shrink behavior.
##
entry main = f(args: string[]): void errors IndexOutOfBoundsError =>
    let mutable xs: int32[] = [4, 5, 6]
    let last = xs.pop()
    print('last {last}')
    print('length {xs.length}')
    print('remaining {propagate xs.at(0)} {propagate xs.at(1)}')
    return void
