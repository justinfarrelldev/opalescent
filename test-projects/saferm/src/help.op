import path_to_string, print from standard
import flags from ./flags

##
    Description: Prints out the help entries with the options
##
public let print_help = f(dest: FilesystemPath): void => 
    print('saferm will put items you remove in {path_to_string(dest)} and allow you to restore them later if desired.')
    print('Options:')
    print('')

    for flag in flags: 
        print('saferm {flag.name} | {flag.description}')
        print('\tUsage:')
        for example in flag.examples:
            print('\t\t{example}')
        
        print('') # newline to delineate new example
