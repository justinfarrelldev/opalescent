import parse_query from ../src/parser
import string_join from standard
import type ParseResult, ParseErrorKind, Statement, PredicateNode, ComparisonOperator from ../src/query.types
import type Column, ColumnType from ../src/schema.types
import type Value from ../src/value.types

scenario parsing table definitions:
    unit under test: parse_query

    it should produce a typed schema in declared order:
        f(): void errors inferred =>
            let result = propagate parse_query('CrEaTe TABLE Tasks (id INT,\n title TEXT, Done BOOL);')
            expect result to be the Parsed variant of ParseResult
            if result is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the CreateTable variant of Statement
                if statement is Statement.CreateTable into create:
                    expect create.name to be 'tasks'
                    let columns: Column[] = create.columns
                    expect columns.length to be 3
                    let first: Column = propagate columns.at(0)
                    let second: Column = propagate columns.at(1)
                    let third: Column = propagate columns.at(2)
                    expect first.name to be 'id'
                    expect second.name to be 'title'
                    expect third.name to be 'done'
                    expect first.column_type to be new ColumnType.Integer
                    expect second.column_type to be new ColumnType.Text
                    expect third.column_type to be new ColumnType.Boolean
            return void

    it should reject a missing semicolon as unexpected end of input:
        f(): void errors inferred =>
            let result = propagate parse_query('CREATE TABLE a (id INT)')
            expect result to be the SyntaxFailure variant of ParseResult
            if result is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedEndOfInput
                expect failure.position.column to be 24
                expect failure.detail to contain ';'
            return void

    it should reject a second statement after the semicolon:
        f(): void errors inferred =>
            let result = propagate parse_query('CREATE TABLE a (id INT); CREATE TABLE b (id INT);')
            expect result to be the SyntaxFailure variant of ParseResult
            if result is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedToken
                expect failure.position.column to be 26
            return void

    it should reject an unknown type name before execution:
        f(): void errors inferred =>
            let result = propagate parse_query('CREATE TABLE tasks (id FLOAT);')
            expect result to be the SyntaxFailure variant of ParseResult
            if result is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnsupportedDataType
                expect failure.position.column to be 24
            return void

scenario parsing row insertion:
    unit under test: parse_query

    it should produce typed literal values in order:
        f(): void errors inferred =>
            let result = propagate parse_query('iNsErT INTO Tasks VALUES (-8, \'Café\', true);')
            expect result to be the Parsed variant of ParseResult
            if result is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the Insert variant of Statement
                if statement is Statement.Insert into insert:
                    expect insert.name to be 'tasks'
                    let values: Value[] = insert.values
                    expect values.length to be 3
                    let first: Value = propagate values.at(0)
                    let second: Value = propagate values.at(1)
                    let third: Value = propagate values.at(2)
                    expect first to be the Integer variant of Value
                    expect second to be the Text variant of Value
                    expect third to be the Boolean variant of Value
                    if first is Value.Integer into number:
                        expect number.content to be -8
                    if second is Value.Text into text:
                        expect text.content to be 'Café'
                    if third is Value.Boolean into flag:
                        expect flag.content to be true
            return void

    it should reject empty rows, missing separators, and truncated rows:
        f(): void errors inferred =>
            let empty = propagate parse_query('INSERT INTO tasks VALUES ();')
            let separator = propagate parse_query('INSERT INTO tasks VALUES (1 true);')
            let truncated = propagate parse_query('INSERT INTO tasks VALUES (1,')
            expect empty to be the SyntaxFailure variant of ParseResult
            expect separator to be the SyntaxFailure variant of ParseResult
            expect truncated to be the SyntaxFailure variant of ParseResult
            if empty is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedToken
                expect failure.detail to contain 'literal'
            if separator is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedToken
                expect failure.detail to contain ', or )'
            if truncated is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedEndOfInput
            return void

scenario parsing wildcard selections:
    unit under test: parse_query

    it should parse a wildcard projection and normalize the source table:
        f(): void errors inferred =>
            let result = propagate parse_query('SeLeCt *\n FROM Tasks;')
            expect result to be the Parsed variant of ParseResult
            if result is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the SelectAll variant of Statement
                if statement is Statement.SelectAll into selection:
                    expect selection.name to be 'tasks'
            return void

    it should require FROM and a nonreserved table name:
        f(): void errors inferred =>
            let missing = propagate parse_query('SELECT * tasks;')
            let reserved = propagate parse_query('SELECT * FROM where;')
            expect missing to be the SyntaxFailure variant of ParseResult
            expect reserved to be the SyntaxFailure variant of ParseResult
            if missing is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.UnexpectedToken
                expect failure.detail to contain 'FROM'
            if reserved is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.InvalidIdentifier
            return void

scenario parsing explicit projections:
    unit under test: parse_query

    it should preserve projected names in order and allow repetitions:
        f(): void errors inferred =>
            let result = propagate parse_query('SELECT Title, ID, title FROM Tasks;')
            expect result to be the Parsed variant of ParseResult
            if result is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the SelectColumns variant of Statement
                if statement is Statement.SelectColumns into selection:
                    expect selection.name to be 'tasks'
                    let columns: string[] = selection.columns
                    expect columns.length to be 3
                    let first: string = propagate columns.at(0)
                    let second: string = propagate columns.at(1)
                    let third: string = propagate columns.at(2)
                    expect first to be 'title'
                    expect second to be 'id'
                    expect third to be 'title'
            return void

    it should reject an empty projection and a trailing comma:
        f(): void errors inferred =>
            let empty = propagate parse_query('SELECT FROM tasks;')
            let trailing = propagate parse_query('SELECT id, FROM tasks;')
            expect empty to be the SyntaxFailure variant of ParseResult
            expect trailing to be the SyntaxFailure variant of ParseResult
            if empty is ParseResult.SyntaxFailure into failure:
                expect failure.detail to contain 'column name'
            if trailing is ParseResult.SyntaxFailure into failure:
                expect failure.detail to contain 'column name'
            return void

scenario parsing predicates:
    unit under test: parse_query

    it should bind AND more tightly than OR:
        f(): void errors inferred =>
            let result = propagate parse_query('SELECT * FROM tasks WHERE done = false OR id >= 1 AND title <> \'X\';')
            expect result to be the Parsed variant of ParseResult
            if result is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the SelectAll variant of Statement
                if statement is Statement.SelectAll into query:
                    let nodes: PredicateNode[] = query.predicate
                    expect nodes.length to be 5
                    let root: PredicateNode = propagate nodes.at(4)
                    expect root to be the Or variant of PredicateNode
                    if root is PredicateNode.Or into either:
                        let left: PredicateNode = propagate nodes.at(either.left)
                        let right: PredicateNode = propagate nodes.at(either.right)
                        expect left to be the Compare variant of PredicateNode
                        expect right to be the And variant of PredicateNode
                        if left is PredicateNode.Compare into comparison:
                            expect comparison.column to be 'done'
                            expect comparison.operator to be new ComparisonOperator.Equal
                        if right is PredicateNode.And into both:
                            let numeric: PredicateNode = propagate nodes.at(both.left)
                            let text: PredicateNode = propagate nodes.at(both.right)
                            if numeric is PredicateNode.Compare into comparison:
                                expect comparison.column to be 'id'
                                expect comparison.operator to be new ComparisonOperator.GreaterEqual
                            if text is PredicateNode.Compare into comparison:
                                expect comparison.column to be 'title'
                                expect comparison.operator to be new ComparisonOperator.NotEqual
            return void

    it should use parentheses and reject a missing closing delimiter:
        f(): void errors inferred =>
            let grouped = propagate parse_query('SELECT id FROM tasks WHERE ((done = false OR id = 1)) AND title = \'X\';')
            let missing = propagate parse_query('SELECT id FROM tasks WHERE (done = false;')
            expect grouped to be the Parsed variant of ParseResult
            expect missing to be the SyntaxFailure variant of ParseResult
            if grouped is ParseResult.Parsed into parsed:
                let statement: Statement = parsed.statement
                expect statement to be the SelectColumns variant of Statement
                if statement is Statement.SelectColumns into query:
                    let nodes: PredicateNode[] = query.predicate
                    expect nodes.length to be 5
                    let root: PredicateNode = propagate nodes.at(4)
                    expect root to be the And variant of PredicateNode
                    if root is PredicateNode.And into both:
                        let left: PredicateNode = propagate nodes.at(both.left)
                        expect left to be the Or variant of PredicateNode
            if missing is ParseResult.SyntaxFailure into failure:
                expect failure.detail to contain ')'
            return void

    it should report excessive nesting as a syntax error:
        f(): void errors inferred =>
            let mutable opens: string[] = []
            let mutable index: int64 = 0
            while index < 80:
                opens.push('(')
                index = index + 1
            let brackets: string = propagate string_join(opens, '')
            let result: ParseResult = propagate parse_query('SELECT * FROM tasks WHERE {brackets}id = 1;')
            expect result to be the SyntaxFailure variant of ParseResult
            if result is ParseResult.SyntaxFailure into failure:
                expect failure.kind to be new ParseErrorKind.PredicateTooComplex
            return void
