import application_executable, terminal_process_launch, terminal_process_send_text, terminal_process_send_key, terminal_process_exited, terminal_process_exit_code, terminal_process_transcript, terminal_process_stop, attach_text from standard.testing
import temporary_directory_create, temporary_directory_file, temporary_directory_remove from standard.testing
import path_from, path_parent_directory, path_to_string, path_exists_sync, write_text_sync, read_text_sync from standard
import type TemporaryDirectory, TerminalProcess from standard.testing

world ReplWorkspace:
    setup: f(): TemporaryDirectory errors inferred =>
        return propagate temporary_directory_create()
    cleanup:
        f(mutable ref workspace: TemporaryDirectory): void errors inferred =>
            propagate temporary_directory_remove(mutable ref workspace)
            return void

world ReplProcess:
    worlds: ReplWorkspace
    setup: f(ref workspace: ReplWorkspace): TerminalProcess errors inferred =>
        let filename = temporary_directory_file(ref workspace.state, 'database.odb')
        let directory = path_to_string(path_parent_directory(path_from(filename)))
        return propagate terminal_process_launch(application_executable(), filename, directory, 100, 32)
    cleanup:
        f(mutable ref process: TerminalProcess): void errors inferred =>
            propagate terminal_process_stop(mutable ref process)
            return void

let send_line = f(mutable ref process: TerminalProcess, text: string): void errors WriteFailureError =>
    propagate terminal_process_send_text(mutable ref process, text)
    propagate terminal_process_send_key(mutable ref process, 'Enter')
    return void

let open_database = f(filename: string): TerminalProcess errors CreateFailureError, AllocationFailureError =>
    let directory: string = path_to_string(path_parent_directory(path_from(filename)))
    return propagate terminal_process_launch(application_executable(), filename, directory, 100, 32)

let quit_database = f(mutable ref process: TerminalProcess): void errors WriteFailureError =>
    propagate send_line(mutable ref process, 'QUIT;')
    expect eventually terminal_process_exited(ref process) to be true within 3 seconds
    expect terminal_process_exit_code(ref process) to be 0
    return void

scenario interacting with the database REPL:
    kind: end_to_end
    worlds: ReplProcess
    after each test:
        f(ref repl: ReplProcess, mutable ref context: TestContext): void =>
            let transcript = terminal_process_transcript(ref repl.state)
            attach_text(mutable ref context, 'terminal transcript', transcript)
            return void

    it should create and query tables and recover from invalid input:
        f(mutable ref repl: ReplProcess): void errors inferred =>
            expect eventually terminal_process_transcript(ref repl.state) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Table \'tasks\' created.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'INSERT INTO tasks VALUES (1, \'Café \\t|\');')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 row inserted.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SELECT * tasks;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'expected FROM' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SELECT * FROM tasks @;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'UnexpectedCharacter at 1:21: @' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SELECT * FROM tasks;')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 | Café \\t\\|' within 3 seconds
            propagate send_line(mutable ref repl.state, 'UPDATE tasks SET title = \'Renamed\' WHERE id >= 1;')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 rows updated.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SELECT title, id FROM tasks WHERE id <> 0 LIMIT 1;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Renamed | 1' within 3 seconds
            propagate send_line(mutable ref repl.state, 'DELETE FROM tasks WHERE id = 1;')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 rows deleted.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'QUIT;')
            expect eventually terminal_process_exited(ref repl.state) to be true within 3 seconds
            expect terminal_process_exit_code(ref repl.state) to be 0
            return void

    it should save, discard unsaved changes on load, and only clear dirty state on success:
        f(mutable ref repl: ReplProcess): void errors inferred =>
            expect eventually terminal_process_transcript(ref repl.state) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'CREATE TABLE tasks (id INT);')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'db*> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'INSERT INTO tasks VALUES (17);')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 row inserted.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'LOAD;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'FilesystemFailure:' within 3 seconds
            expect eventually terminal_process_transcript(ref repl.state) to contain 'FileNotFoundError' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SAVE;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Database saved.\r\ndb> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'UPDATE tasks SET id = 17;')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 rows updated.\r\ndb> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'INSERT INTO tasks VALUES (99);')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 row inserted.\r\ndb*> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'LOAD;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Database loaded.\r\ndb> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'SELECT * FROM tasks;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'id\r\n17\r\n1 rows returned.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'DELETE FROM tasks;')
            expect eventually terminal_process_transcript(ref repl.state) to contain '1 rows deleted.\r\ndb*> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'QUIT;')
            expect eventually terminal_process_exited(ref repl.state) to be true within 3 seconds
            expect terminal_process_transcript(ref repl.state) to contain 'Discarding unsaved changes.'
            expect terminal_process_exit_code(ref repl.state) to be 0
            return void

    it should show tables and schemas in their declared order:
        f(mutable ref repl: ReplProcess): void errors inferred =>
            expect eventually terminal_process_transcript(ref repl.state) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref repl.state, 'hElP;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Available commands:' within 3 seconds
            propagate send_line(mutable ref repl.state, 'CREATE TABLE tasks (id INT, title TEXT, done BOOL);')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Table \'tasks\' created.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'CREATE TABLE logs (message TEXT);')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Table \'logs\' created.' within 3 seconds
            propagate send_line(mutable ref repl.state, 'sHoW Tables;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'Tables: tasks, logs' within 3 seconds
            propagate send_line(mutable ref repl.state, 'DESCRIBE TASKS;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'id INT, title TEXT, done BOOL' within 3 seconds
            propagate send_line(mutable ref repl.state, 'DESCRIBE missing;')
            expect eventually terminal_process_transcript(ref repl.state) to contain 'UnknownTable: table \'missing\' does not exist.' within 3 seconds
            propagate quit_database(mutable ref repl.state)
            return void

scenario reopening a persistent database:
    kind: end_to_end
    worlds: ReplWorkspace

    it should preserve successive saves but not implicitly save on exit:
        f(ref workspace: ReplWorkspace): void errors inferred =>
            let filename: string = temporary_directory_file(ref workspace.state, 'persistent.odb')
            let path: FilesystemPath = path_from(filename)
            let mutable first: TerminalProcess = propagate open_database(filename)
            expect eventually terminal_process_transcript(ref first) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref first, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect eventually terminal_process_transcript(ref first) to contain 'Table \'tasks\' created.' within 3 seconds
            propagate send_line(mutable ref first, 'INSERT INTO tasks VALUES (1, \'First\');')
            propagate send_line(mutable ref first, 'INSERT INTO tasks VALUES (2, \'Café\');')
            let absent: boolean = propagate path_exists_sync(path)
            expect absent to be false
            propagate send_line(mutable ref first, 'SAVE;')
            expect eventually terminal_process_transcript(ref first) to contain 'Database saved.' within 3 seconds
            propagate quit_database(mutable ref first)
            propagate terminal_process_stop(mutable ref first)

            let mutable second: TerminalProcess = propagate open_database(filename)
            expect eventually terminal_process_transcript(ref second) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref second, 'DESCRIBE tasks;')
            expect eventually terminal_process_transcript(ref second) to contain 'id INT, title TEXT' within 3 seconds
            propagate send_line(mutable ref second, 'SELECT * FROM tasks;')
            expect eventually terminal_process_transcript(ref second) to contain '1 | First\r\n2 | Café' within 3 seconds
            propagate send_line(mutable ref second, 'UPDATE tasks SET title = \'lost\', id = \'bad\';')
            expect eventually terminal_process_transcript(ref second) to contain 'TypeMismatch:' within 3 seconds
            propagate send_line(mutable ref second, 'UPDATE tasks SET title = \'Second\' WHERE id = 2;')
            expect eventually terminal_process_transcript(ref second) to contain '1 rows updated.' within 3 seconds
            propagate send_line(mutable ref second, 'SAVE;')
            expect eventually terminal_process_transcript(ref second) to contain 'Database saved.' within 3 seconds
            propagate send_line(mutable ref second, 'DELETE FROM tasks;')
            expect eventually terminal_process_transcript(ref second) to contain '2 rows deleted.' within 3 seconds
            propagate quit_database(mutable ref second)
            expect terminal_process_transcript(ref second) to contain 'Discarding unsaved changes.'
            propagate terminal_process_stop(mutable ref second)

            let mutable third: TerminalProcess = propagate open_database(filename)
            expect eventually terminal_process_transcript(ref third) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref third, 'SELECT * FROM tasks;')
            expect eventually terminal_process_transcript(ref third) to contain '1 | First\r\n2 | Second' within 3 seconds
            propagate quit_database(mutable ref third)
            propagate terminal_process_stop(mutable ref third)
            return void

    it should keep the active dirty database when a replacement snapshot is invalid:
        f(ref workspace: ReplWorkspace): void errors inferred =>
            let filename: string = temporary_directory_file(ref workspace.state, 'replace.odb')
            let path: FilesystemPath = path_from(filename)
            let mutable process: TerminalProcess = propagate open_database(filename)
            expect eventually terminal_process_transcript(ref process) to contain 'db> ' within 3 seconds
            propagate send_line(mutable ref process, 'CREATE TABLE tasks (id INT);')
            propagate send_line(mutable ref process, 'INSERT INTO tasks VALUES (12);')
            expect eventually terminal_process_transcript(ref process) to contain '1 row inserted.' within 3 seconds
            propagate write_text_sync(path, 'OPALDB 1\nEND 2 3\n')
            propagate send_line(mutable ref process, 'LOAD;')
            expect eventually terminal_process_transcript(ref process) to contain 'incorrect table or row counts\r\ndb*> ' within 3 seconds
            propagate send_line(mutable ref process, 'SELECT * FROM tasks;')
            expect eventually terminal_process_transcript(ref process) to contain 'id\r\n12\r\n1 rows returned.' within 3 seconds
            propagate quit_database(mutable ref process)
            expect terminal_process_transcript(ref process) to contain 'Discarding unsaved changes.'
            propagate terminal_process_stop(mutable ref process)
            let contents: string = propagate read_text_sync(path)
            expect contents to be 'OPALDB 1\nEND 2 3\n'
            return void

    it should reject a corrupt startup file without changing it:
        f(ref workspace: ReplWorkspace): void errors inferred =>
            let filename: string = temporary_directory_file(ref workspace.state, 'corrupt.odb')
            let path: FilesystemPath = path_from(filename)
            propagate write_text_sync(path, 'OPALDB 1\n')
            let mutable process: TerminalProcess = propagate open_database(filename)
            expect eventually terminal_process_exited(ref process) to be true within 3 seconds
            expect terminal_process_exit_code(ref process) to be 1
            expect terminal_process_transcript(ref process) to contain 'InvalidSnapshot'
            propagate terminal_process_stop(mutable ref process)
            let contents: string = propagate read_text_sync(path)
            expect contents to be 'OPALDB 1\n'
            return void
