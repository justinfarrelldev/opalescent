import empty_database, execute_create, execute_insert, execute_select_all, execute_select_columns, execute_select_where, execute_delete from ../src/database
import integer_value, text_value from ../src/value
import parse_query from ../src/parser
import type Database, CreateResult, Table, Creation, Insertion, InsertResult, SelectResult, Mutation, MutationResult from ../src/database.types
import type ParseResult, Statement, PredicateNode from ../src/query.types
import type PredicateError from ../src/predicate.types
import type Column from ../src/schema.types
import type Value from ../src/value.types

world EmptyDatabase:
    setup: f(): Database =>
        return empty_database()

let apply_create = f(mutable ref db: Database, source: string): CreateResult errors IndexOutOfBoundsError, AllocationFailureError =>
    let parsed_query = propagate parse_query(source)
    expect parsed_query to be the Parsed variant of ParseResult
    if parsed_query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        if statement is Statement.CreateTable into create:
            let columns: Column[] = create.columns
            let outcome: Creation = propagate execute_create(db, create.name, ref columns)
            let state: Database = outcome.state
            db.tables = state.tables
            let result: CreateResult = outcome.result
            return result
    # The assertion above aborts the worker on this path.
    let result: CreateResult = new CreateResult.EmptySchema:
        table_name: 'unreachable'
    return result

scenario creating in-memory tables:
    unit under test: execute_create
    worlds: EmptyDatabase

    it should create independent empty tables in creation order:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let first = propagate apply_create(mutable ref db.state, 'CREATE TABLE Tasks (id INT, title TEXT);')
            let second = propagate apply_create(mutable ref db.state, 'CREATE TABLE users (active BOOL);')
            expect first to be the Created variant of CreateResult
            expect second to be the Created variant of CreateResult
            let tables: Table[] = db.state.tables
            expect tables.length to be 2
            let first_table: Table = propagate tables.at(0)
            let second_table: Table = propagate tables.at(1)
            expect first_table.name to be 'tasks'
            expect second_table.name to be 'users'
            let first_columns: Column[] = first_table.columns
            let second_columns: Column[] = second_table.columns
            let first_rows: Value[][] = first_table.rows
            let second_rows: Value[][] = second_table.rows
            expect first_columns.length to be 2
            expect second_columns.length to be 1
            expect first_rows.length to be 0
            expect second_rows.length to be 0
            return void

    it should reject duplicate names and leave the original schema intact:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            let table_result = propagate apply_create(mutable ref db.state, 'CREATE TABLE TASKS (active BOOL);')
            let column_result = propagate apply_create(mutable ref db.state, 'CREATE TABLE users (id INT, ID TEXT);')
            expect created to be the Created variant of CreateResult
            expect table_result to be the DuplicateTable variant of CreateResult
            expect column_result to be the DuplicateColumn variant of CreateResult
            let tables: Table[] = db.state.tables
            expect tables.length to be 1
            let table: Table = propagate tables.at(0)
            expect table.name to be 'tasks'
            let columns: Column[] = table.columns
            expect columns.length to be 2
            let first_column: Column = propagate columns.at(0)
            let second_column: Column = propagate columns.at(1)
            expect first_column.name to be 'id'
            expect second_column.name to be 'title'
            return void

let insert_query = f(database: Database, source: string): Insertion errors IndexOutOfBoundsError, AllocationFailureError =>
    let parsed_query: ParseResult = propagate parse_query(source)
    expect parsed_query to be the Parsed variant of ParseResult
    if parsed_query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        expect statement to be the Insert variant of Statement
        if statement is Statement.Insert into insert:
            let values: Value[] = insert.values
            return propagate execute_insert(database, insert.name, ref values)
    # These assertions abort the worker on the invalid paths.
    let result: InsertResult = new InsertResult.UnknownTable:
        name: 'unreachable'
    let outcome: Insertion = new Insertion:
        state: database
        result: result
    return outcome

scenario inserting typed rows:
    unit under test: execute_insert
    worlds: EmptyDatabase

    it should append complete rows in order and preserve other tables:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let tasks = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect tasks to be the Created variant of CreateResult
            let other = propagate apply_create(mutable ref db.state, 'CREATE TABLE other (id INT);')
            expect other to be the Created variant of CreateResult
            let first: Insertion = propagate insert_query(db.state, 'INSERT INTO Tasks VALUES (1, \'First\');')
            expect first.result to be the Inserted variant of InsertResult
            let first_state: Database = first.state
            let second: Insertion = propagate insert_query(first_state, 'INSERT INTO tasks VALUES (2, \'Café\');')
            let result: InsertResult = second.result
            expect result to be the Inserted variant of InsertResult
            if result is InsertResult.Inserted into inserted:
                expect inserted.count to be 1
            let state: Database = second.state
            let tables: Table[] = state.tables
            expect tables.length to be 2
            let table: Table = propagate tables.at(0)
            let untouched: Table = propagate tables.at(1)
            expect untouched.rows.length to be 0
            let rows: Value[][] = table.rows
            expect rows.length to be 2
            let row_one: Value[] = propagate rows.at(0)
            let row_two: Value[] = propagate rows.at(1)
            let first_id: Value = propagate row_one.at(0)
            let second_id: Value = propagate row_two.at(0)
            let title: Value = propagate row_two.at(1)
            expect first_id to be the Integer variant of Value
            expect second_id to be the Integer variant of Value
            expect title to be the Text variant of Value
            if first_id is Value.Integer into number:
                expect number.content to be 1
            if second_id is Value.Integer into number:
                expect number.content to be 2
            if title is Value.Text into text:
                expect text.content to be 'Café'
            return void

    it should reject missing tables, incorrect widths, and mismatched types before appending:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect created to be the Created variant of CreateResult
            let valid: Value[] = [integer_value(1), text_value('Original')]
            let short: Value[] = [integer_value(2)]
            let invalid: Value[] = [integer_value(2), integer_value(3)]
            let original: Insertion = propagate execute_insert(db.state, 'tasks', ref valid)
            expect original.result to be the Inserted variant of InsertResult
            let missing: Insertion = propagate execute_insert(original.state, 'missing', ref valid)
            let incorrect: Insertion = propagate execute_insert(missing.state, 'tasks', ref short)
            let mismatched: Insertion = propagate execute_insert(incorrect.state, 'tasks', ref invalid)
            expect missing.result to be the UnknownTable variant of InsertResult
            expect incorrect.result to be the IncorrectValueCount variant of InsertResult
            expect mismatched.result to be the TypeMismatch variant of InsertResult
            let state: Database = mismatched.state
            let tables: Table[] = state.tables
            let table: Table = propagate tables.at(0)
            let rows: Value[][] = table.rows
            expect rows.length to be 1
            let row: Value[] = propagate rows.at(0)
            let title: Value = propagate row.at(1)
            expect title to be the Text variant of Value
            if title is Value.Text into text:
                expect text.content to be 'Original'
            return void

scenario selecting all columns:
    unit under test: execute_select_all
    worlds: EmptyDatabase

    it should return schema metadata for an empty table and distinguish missing tables:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect created to be the Created variant of CreateResult
            let state: Database = db.state
            let empty: SelectResult = propagate execute_select_all(ref state, 'tasks')
            let missing: SelectResult = propagate execute_select_all(ref state, 'missing')
            expect empty to be the Selected variant of SelectResult
            expect missing to be the UnknownTable variant of SelectResult
            if empty is SelectResult.Selected into selection:
                let columns: Column[] = selection.columns
                let rows: Value[][] = selection.rows
                expect columns.length to be 2
                expect rows.length to be 0
                let first: Column = propagate columns.at(0)
                let second: Column = propagate columns.at(1)
                expect first.name to be 'id'
                expect second.name to be 'title'
            return void

    it should keep an earlier owned result stable across later statements:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (title TEXT);')
            expect created to be the Created variant of CreateResult
            let first: Insertion = propagate insert_query(db.state, 'INSERT INTO tasks VALUES (\'before\');')
            expect first.result to be the Inserted variant of InsertResult
            let state: Database = first.state
            let saved: SelectResult = propagate execute_select_all(ref state, 'tasks')
            let second: Insertion = propagate insert_query(state, 'INSERT INTO tasks VALUES (\'after\');')
            expect second.result to be the Inserted variant of InsertResult
            let changed: Database = second.state
            let current: SelectResult = propagate execute_select_all(ref changed, 'tasks')
            expect saved to be the Selected variant of SelectResult
            expect current to be the Selected variant of SelectResult
            if current is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 2
            if saved is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 1
                let row: Value[] = propagate rows.at(0)
                let cell: Value = propagate row.at(0)
                expect cell to be the Text variant of Value
                if cell is Value.Text into text:
                    expect text.content to be 'before'
            return void

scenario projecting selected columns:
    unit under test: execute_select_columns
    worlds: EmptyDatabase

    it should retain the requested column and row order including repeated columns:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT);')
            expect created to be the Created variant of CreateResult
            let first: Insertion = propagate insert_query(db.state, 'INSERT INTO tasks VALUES (1, \'first\');')
            let first_state: Database = first.state
            let second: Insertion = propagate insert_query(first_state, 'INSERT INTO tasks VALUES (2, \'second\');')
            let state: Database = second.state
            let wanted: string[] = ['title', 'id', 'title']
            let result: SelectResult = propagate execute_select_columns(ref state, 'tasks', ref wanted)
            expect result to be the Selected variant of SelectResult
            if result is SelectResult.Selected into selected:
                let columns: Column[] = selected.columns
                expect columns.length to be 3
                let rows: Value[][] = selected.rows
                expect rows.length to be 2
                let first: Value[] = propagate rows.at(0)
                let second: Value[] = propagate rows.at(1)
                expect first.length to be 3
                let title: Value = propagate first.at(0)
                let id: Value = propagate first.at(1)
                let repeated: Value = propagate first.at(2)
                let next_title: Value = propagate second.at(0)
                expect title to be the Text variant of Value
                expect id to be the Integer variant of Value
                expect repeated to be the Text variant of Value
                expect next_title to be the Text variant of Value
                if title is Value.Text into value:
                    expect value.content to be 'first'
                if id is Value.Integer into value:
                    expect value.content to be 1
                if repeated is Value.Text into value:
                    expect value.content to be 'first'
                if next_title is Value.Text into value:
                    expect value.content to be 'second'
            return void

    it should validate all projected columns even on empty tables:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT);')
            expect created to be the Created variant of CreateResult
            let state: Database = db.state
            let wanted: string[] = ['id', 'missing']
            let result: SelectResult = propagate execute_select_columns(ref state, 'tasks', ref wanted)
            expect result to be the UnknownColumn variant of SelectResult
            if result is SelectResult.UnknownColumn into unknown:
                expect unknown.table_name to be 'tasks'
                expect unknown.column_name to be 'missing'
            return void

let select_query = f(ref database: Database, source: string): SelectResult errors IndexOutOfBoundsError, AllocationFailureError =>
    let query: ParseResult = propagate parse_query(source)
    expect query to be the Parsed variant of ParseResult
    if query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        if statement is Statement.SelectColumns into select:
            let columns: string[] = select.columns
            let predicate: PredicateNode[] = select.predicate
            return propagate execute_select_where(ref database, select.name, ref columns, ref predicate, select.limit)
    let unreachable: SelectResult = new SelectResult.UnknownTable:
        name: 'unreachable'
    return unreachable

let expect_id = f(ref rows: Value[][], index: int64, expected: int64): void errors IndexOutOfBoundsError =>
    let row: Value[] = propagate rows.at(index)
    let cell: Value = propagate row.at(0)
    expect cell to be the Integer variant of Value
    if cell is Value.Integer into value:
        expect value.content to be expected
    return void

scenario evaluating validated predicates:
    unit under test: execute_select_where
    worlds: EmptyDatabase

    it should filter before projecting and respect grouping and case sensitive text:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT, done BOOL);')
            expect created to be the Created variant of CreateResult
            let first: Insertion = propagate insert_query(db.state, 'INSERT INTO tasks VALUES (1, \'x\', false);')
            let first_state: Database = first.state
            let second: Insertion = propagate insert_query(first_state, 'INSERT INTO tasks VALUES (2, \'X\', true);')
            let second_state: Database = second.state
            let third: Insertion = propagate insert_query(second_state, 'INSERT INTO tasks VALUES (3, \'x\', true);')
            let state: Database = third.state
            let precedence: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE done != true OR id >= 2 AND title = \'X\';')
            let grouped: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE (done != true OR id >= 2) AND title = \'X\';')
            expect precedence to be the Selected variant of SelectResult
            expect grouped to be the Selected variant of SelectResult
            if precedence is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 2
                propagate expect_id(ref rows, 0, 1)
                propagate expect_id(ref rows, 1, 2)
            if grouped is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 1
                propagate expect_id(ref rows, 0, 2)
            return void

    it should validate every branch even when the table is empty:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT, title TEXT, done BOOL);')
            expect created to be the Created variant of CreateResult
            let state: Database = db.state
            let missing: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE id = 1 OR missing = true;')
            let mismatch: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE id = \'1\';')
            let unsupported: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE done > false;')
            expect missing to be the InvalidPredicate variant of SelectResult
            expect mismatch to be the InvalidPredicate variant of SelectResult
            expect unsupported to be the InvalidPredicate variant of SelectResult
            if missing is SelectResult.InvalidPredicate into failure:
                expect failure.problem to be the UnknownColumn variant of PredicateError
            if mismatch is SelectResult.InvalidPredicate into failure:
                expect failure.problem to be the TypeMismatch variant of PredicateError
            if unsupported is SelectResult.InvalidPredicate into failure:
                expect failure.problem to be the UnsupportedOperator variant of PredicateError
            return void

    it should apply limits after filtering and validate a zero limit query:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT);')
            expect created to be the Created variant of CreateResult
            let first: Insertion = propagate insert_query(db.state, 'INSERT INTO tasks VALUES (1);')
            let first_state: Database = first.state
            let second: Insertion = propagate insert_query(first_state, 'INSERT INTO tasks VALUES (2);')
            let second_state: Database = second.state
            let third: Insertion = propagate insert_query(second_state, 'INSERT INTO tasks VALUES (3);')
            let state: Database = third.state
            let capped: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE id > 1 LIMIT 1;')
            let uncapped: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE id <= 2 LIMIT 9223372036854775807;')
            let zero: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks LIMIT 0;')
            let invalid: SelectResult = propagate select_query(ref state, 'SELECT id FROM tasks WHERE id > 0 OR missing = 1 LIMIT 0;')
            expect capped to be the Selected variant of SelectResult
            expect uncapped to be the Selected variant of SelectResult
            expect zero to be the Selected variant of SelectResult
            expect invalid to be the InvalidPredicate variant of SelectResult
            if capped is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 1
                propagate expect_id(ref rows, 0, 2)
            if uncapped is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 2
                propagate expect_id(ref rows, 0, 1)
                propagate expect_id(ref rows, 1, 2)
            if zero is SelectResult.Selected into selection:
                expect selection.rows.length to be 0
            return void

let delete_query = f(database: Database, source: string): Mutation errors IndexOutOfBoundsError, AllocationFailureError =>
    let query: ParseResult = propagate parse_query(source)
    expect query to be the Parsed variant of ParseResult
    if query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        expect statement to be the Delete variant of Statement
        if statement is Statement.Delete into deletion:
            let predicate: PredicateNode[] = deletion.predicate
            return propagate execute_delete(database, deletion.name, ref predicate)
    let result: MutationResult = new MutationResult.UnknownTable:
        name: 'unreachable'
    let outcome: Mutation = new Mutation:
        state: database
        result: result
    return outcome

let expect_deleted = f(result: MutationResult, count: int64): void =>
    expect result to be the Deleted variant of MutationResult
    if result is MutationResult.Deleted into deleted:
        expect deleted.count to be count
    return void

scenario deleting rows:
    unit under test: execute_delete
    worlds: EmptyDatabase

    it should delete one, several, or all while preserving survivor order and previous results:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT);')
            expect created to be the Created variant of CreateResult
            let mutable state: Database = db.state
            let mutable id: int64 = 1
            while id <= 5:
                let inserted: Insertion = propagate insert_query(state, 'INSERT INTO tasks VALUES ({id});')
                let next: Database = inserted.state
                state = next
                id = id + 1
            let before: SelectResult = propagate execute_select_all(ref state, 'tasks')
            let one: Mutation = propagate delete_query(state, 'DELETE FROM tasks WHERE id = 2;')
            expect_deleted(one.result, 1)
            let several: Mutation = propagate delete_query(one.state, 'DELETE FROM tasks WHERE id = 3 OR id = 5;')
            expect_deleted(several.result, 2)
            let rest: Database = several.state
            let selected: SelectResult = propagate execute_select_all(ref rest, 'tasks')
            if selected is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 2
                propagate expect_id(ref rows, 0, 1)
                propagate expect_id(ref rows, 1, 4)
            let all: Mutation = propagate delete_query(rest, 'DELETE FROM tasks;')
            expect_deleted(all.result, 2)
            let empty: Database = all.state
            let none: Mutation = propagate delete_query(empty, 'DELETE FROM tasks WHERE id = 1;')
            expect_deleted(none.result, 0)
            let after: SelectResult = propagate execute_select_all(ref empty, 'tasks')
            expect after to be the Selected variant of SelectResult
            if after is SelectResult.Selected into selection:
                expect selection.columns.length to be 1
                expect selection.rows.length to be 0
            expect before to be the Selected variant of SelectResult
            if before is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 5
                propagate expect_id(ref rows, 1, 2)
            return void

    it should leave the rows unchanged after predicate validation fails:
        f(mutable ref db: EmptyDatabase): void errors inferred =>
            let created = propagate apply_create(mutable ref db.state, 'CREATE TABLE tasks (id INT);')
            expect created to be the Created variant of CreateResult
            let inserted: Insertion = propagate insert_query(db.state, 'INSERT INTO tasks VALUES (1);')
            let invalid: Mutation = propagate delete_query(inserted.state, 'DELETE FROM tasks WHERE id = 1 OR missing = 3;')
            expect invalid.result to be the InvalidPredicate variant of MutationResult
            let state: Database = invalid.state
            let selected: SelectResult = propagate execute_select_all(ref state, 'tasks')
            expect selected to be the Selected variant of SelectResult
            if selected is SelectResult.Selected into selection:
                let rows: Value[][] = selection.rows
                expect rows.length to be 1
                propagate expect_id(ref rows, 0, 1)
            return void
