import type Database, Table, CreateResult, Creation, InsertResult, Insertion, SelectResult, Mutation, MutationResult from ./database.types
import type Column from ./schema.types
import column_index_of, value_matches from ./schema
import validate_predicate, row_matches from ./predicate
import type ResolvedNode, PredicateValidation from ./predicate.types
import type Value from ./value.types
import type IndexAccessErrors from standard.errors
import type PredicateNode, RowLimit from ./query.types

##
  Description: Creates an empty database with no tables.
##
public let empty_database = f(): Database =>
    let database: Database = new Database:
        tables: []
    return database

# A negative index means the normalized name was not found.
let table_index_of = f(ref tables: Table[], name: string): int64 errors IndexAccessErrors =>
    let mutable index: int64 = 0
    while index < tables.length:
        let table: Table = propagate tables.at(index)
        if table.name is name:
            return index
        index = index + 1
    return -1

let creation = f(state: Database, result: CreateResult): Creation =>
    return new Creation:
        state: state
        result: result

##
  Description: Validates and adds a table with normalized names and ordered columns.
##
public let execute_create = f(
    database: Database,
    table_name: string,
    ref columns: Column[]
): Creation errors IndexAccessErrors =>
    let mutable tables: Table[] = database.tables
    let table_index: int64 = propagate table_index_of(ref tables, table_name)
    if table_index >= 0:
        let result: CreateResult = new CreateResult.DuplicateTable:
            name: table_name
        return creation(database, result)
    if columns.length is 0:
        let result: CreateResult = new CreateResult.EmptySchema:
            table_name: table_name
        return creation(database, result)
    let mutable index: int64 = 0
    let mutable schema: Column[] = []
    while index < columns.length:
        let column: Column = propagate columns.at(index)
        let column_name: string = column.name
        let mutable previous_index: int64 = 0
        while previous_index < index:
            let earlier: Column = propagate schema.at(previous_index)
            let earlier_name: string = earlier.name
            if earlier_name is column_name:
                let result: CreateResult = new CreateResult.DuplicateColumn:
                    table_name: table_name
                    column_name: column_name
                return creation(database, result)
            previous_index = previous_index + 1
        schema.push(column)
        index = index + 1
    let rows: Value[][] = []
    let table: Table = new Table:
        name: table_name
        columns: schema
        rows: rows
    tables.push(table)
    let changed: Database = new Database:
        tables: tables
    let result: CreateResult = new CreateResult.Created:
        name: table_name
    let outcome: Creation = new Creation:
        state: changed
        result: result
    return outcome

let replace_rows = f(database: Database, table_index: int64, table: Table, rows: Value[][]): Database =>
    let columns: Column[] = table.columns
    let replacement: Table = new Table:
        name: table.name
        columns: columns
        rows: rows
    let mutable tables: Table[] = database.tables
    tables[table_index] = replacement
    let state: Database = new Database:
        tables: tables
    return state

let insertion = f(state: Database, result: InsertResult): Insertion =>
    return new Insertion:
        state: state
        result: result

##
  Description: Validates row width and types before appending a single row.
##
public let execute_insert = f(database: Database, name: string, ref values: Value[]): Insertion errors IndexAccessErrors =>
    let tables: Table[] = database.tables
    let table_index: int64 = propagate table_index_of(ref tables, name)
    if table_index < 0:
        let missing: InsertResult = new InsertResult.UnknownTable:
            name: name
        return insertion(database, missing)
    let table: Table = propagate tables.at(table_index)
    let columns: Column[] = table.columns
    if columns.length is not values.length:
        let mismatch: InsertResult = new InsertResult.IncorrectValueCount:
            table_name: name
            expected: columns.length
            actual: values.length
        return insertion(database, mismatch)
    let mutable row: Value[] = []
    let mutable index: int64 = 0
    while index < columns.length:
        let column: Column = propagate columns.at(index)
        let value: Value = propagate values.at(index)
        if not value_matches(column.column_type, value):
            let mismatch: InsertResult = new InsertResult.TypeMismatch:
                table_name: name
                column_name: column.name
            return insertion(database, mismatch)
        row.push(value)
        index = index + 1
    let mutable rows: Value[][] = table.rows
    rows.push(row)
    let state: Database = replace_rows(database, table_index, table, rows)
    let result: InsertResult = new InsertResult.Inserted:
        count: 1
    return insertion(state, result)

##
  Description: Returns column metadata and rows in their original order.
##
public let execute_select_all = f(ref database: Database, name: string): SelectResult errors IndexAccessErrors =>
    let tables: Table[] = database.tables
    let index: int64 = propagate table_index_of(ref tables, name)
    if index < 0:
        let missing: SelectResult = new SelectResult.UnknownTable:
            name: name
        return missing
    let table: Table = propagate tables.at(index)
    let columns: Column[] = table.columns
    let rows: Value[][] = table.rows
    let selected: SelectResult = new SelectResult.Selected:
        columns: columns
        rows: rows
    return selected

let project_row = f(ref row: Value[], ref indices: int64[]): Value[] errors IndexAccessErrors =>
    let mutable cells: Value[] = []
    let mutable index: int64 = 0
    while index < indices.length:
        let position: int64 = propagate indices.at(index)
        let cell: Value = propagate row.at(position)
        cells.push(cell)
        index = index + 1
    return cells

##
  Description: Resolves projections and predicates before scanning rows. Empty names mean wildcard.
##
public let execute_select_where = f(ref database: Database, name: string, ref names: string[], ref predicate: PredicateNode[], limit: RowLimit): SelectResult errors IndexAccessErrors =>
    let all: SelectResult = propagate execute_select_all(ref database, name)
    if names.length is 0 and predicate.length is 0 and limit is RowLimit.Unlimited:
        return all
    if all is SelectResult.Selected into table:
        let schema: Column[] = table.columns
        let rows: Value[][] = table.rows
        let mutable columns: Column[] = []
        let mutable indices: int64[] = []
        let mutable index: int64 = 0
        while index < names.length:
            let requested: string = propagate names.at(index)
            let resolved: int64 = propagate column_index_of(ref schema, requested)
            if resolved < 0:
                let unknown: SelectResult = new SelectResult.UnknownColumn:
                    table_name: name
                    column_name: requested
                return unknown
            let column: Column = propagate schema.at(resolved)
            columns.push(column)
            indices.push(resolved)
            index = index + 1
        if names.length is 0:
            columns = schema
        let validation: PredicateValidation = propagate validate_predicate(ref schema, ref predicate)
        if validation is PredicateValidation.Invalid into failure:
            let result: SelectResult = new SelectResult.InvalidPredicate:
                table_name: name
                problem: failure.problem
            return result
        if validation is PredicateValidation.Valid into valid:
            let nodes: ResolvedNode[] = valid.nodes
            let mutable output: Value[][] = []
            let mutable row_index: int64 = 0
            # Only matching rows count toward the limit, after validation above.
            let mutable remaining: int64 = rows.length
            if limit is RowLimit.AtMost into bound:
                remaining = bound.rows
            while row_index < rows.length and remaining > 0:
                let row: Value[] = propagate rows.at(row_index)
                let matches: boolean = propagate row_matches(ref nodes, ref row)
                if matches:
                    if names.length is 0:
                        output.push(row)
                    else:
                        let cells: Value[] = propagate project_row(ref row, ref indices)
                        output.push(cells)
                    remaining = remaining - 1
                row_index = row_index + 1
            let result: SelectResult = new SelectResult.Selected:
                columns: columns
                rows: output
            return result
    return all

##
  Description: Projects all rows onto the requested ordered columns.
##
public let execute_select_columns = f(ref database: Database, name: string, ref names: string[]): SelectResult errors IndexAccessErrors =>
    let predicate: PredicateNode[] = []
    return propagate execute_select_where(ref database, name, ref names, ref predicate, new RowLimit.Unlimited)

let mutation = f(state: Database, result: MutationResult): Mutation =>
    return new Mutation:
        state: state
        result: result

##
  Description: Removes matching rows only after predicate validation succeeds.
##
public let execute_delete = f(database: Database, name: string, ref predicate: PredicateNode[]): Mutation errors IndexAccessErrors =>
    let tables: Table[] = database.tables
    let table_index: int64 = propagate table_index_of(ref tables, name)
    if table_index < 0:
        let missing: MutationResult = new MutationResult.UnknownTable:
            name: name
        return mutation(database, missing)
    let table: Table = propagate tables.at(table_index)
    let columns: Column[] = table.columns
    let validation: PredicateValidation = propagate validate_predicate(ref columns, ref predicate)
    if validation is PredicateValidation.Invalid into failure:
        let result: MutationResult = new MutationResult.InvalidPredicate:
            table_name: name
            problem: failure.problem
        return mutation(database, result)
    let mutable survivors: Value[][] = []
    let rows: Value[][] = table.rows
    if validation is PredicateValidation.Valid into valid:
        let nodes: ResolvedNode[] = valid.nodes
        if nodes.length > 0:
            let mutable index: int64 = 0
            while index < rows.length:
                let row: Value[] = propagate rows.at(index)
                let matches: boolean = propagate row_matches(ref nodes, ref row)
                if not matches:
                    survivors.push(row)
                index = index + 1
    let removed: int64 = rows.length - survivors.length
    let result: MutationResult = new MutationResult.Deleted:
        count: removed
    if removed is 0:
        return mutation(database, result)
    return mutation(replace_rows(database, table_index, table, survivors), result)
