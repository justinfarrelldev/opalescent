##
  Description: One-based line and Unicode scalar column in query text.
##
public type SourcePosition:
    line: int64
    column: int64

##
  Description: Keyword, identifier, delimiter, or end marker emitted by the tokenizer.
##
public type TokenKind:
    Identifier:
        name: string
    IntegerLiteral:
        value: int64
    StringLiteral:
        value: string
    Create
    Table
    Insert
    Into
    Values
    Select
    From
    Where
    Limit
    Update
    Set
    Delete
    And
    Or
    Help
    Show
    Tables
    Describe
    Quit
    Save
    Load
    BooleanLiteral:
        value: boolean
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    IntType
    TextType
    BoolType
    OpenParen
    CloseParen
    Comma
    Semicolon
    Asterisk
    EndOfInput

##
  Description: A query token with its starting position.
##
public type Token:
    kind: TokenKind
    position: SourcePosition

##
  Description: Categories of invalid query text detected during tokenization.
##
public type LexErrorKind:
    UnexpectedCharacter
    InvalidIntegerLiteral
    IntegerOverflow
    UnterminatedString
    InvalidEscape

##
  Description: Tokenization yields either a complete token stream or a diagnostic.
##
public type LexResult:
    Success:
        tokens: Token[]
    Failure:
        kind: LexErrorKind
        position: SourcePosition
        detail: string
