import type SourcePosition, LexErrorKind from ./lexer.types
import type Column from ./schema.types
import type Value from ./value.types

##
  Description: A parsed database statement, independent of engine state.
##
public type Statement:
    CreateTable:
        name: string
        columns: Column[]
    Insert:
        name: string
        values: Value[]
    SelectAll:
        name: string
        predicate: PredicateNode[]
        limit: RowLimit
    SelectColumns:
        name: string
        columns: string[]
        predicate: PredicateNode[]
        limit: RowLimit
    Delete:
        name: string
        predicate: PredicateNode[]
    Update:
        name: string
        assignments: Assignment[]
        predicate: PredicateNode[]

public type Assignment:
    column: string
    value: Value

public type RowLimit:
    Unlimited
    AtMost:
        rows: int64

public type ComparisonOperator:
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual

##
  Description: Postorder predicate node. The last node is the root; an empty array means no WHERE.
##
public type PredicateNode:
    Compare:
        column: string
        operator: ComparisonOperator
        value: Value
    And:
        left: int64
        right: int64
    Or:
        left: int64
        right: int64

public type LiteralParse:
    Literal:
        value: Value
    NotLiteral

##
  Description: Categories of invalid query syntax detected by the parser.
##
public type ParseErrorKind:
    UnexpectedToken
    UnexpectedEndOfInput
    InvalidIdentifier
    UnsupportedDataType
    PredicateTooComplex
    InvalidLimit

##
  Description: Structured statement or positioned diagnostic for a single query.
##
public type ParseResult:
    Parsed:
        statement: Statement
    LexicalFailure:
        kind: LexErrorKind
        position: SourcePosition
        detail: string
    SyntaxFailure:
        kind: ParseErrorKind
        position: SourcePosition
        detail: string

public type PredicateProgress:
    Done:
        next: int64
        root: int64
        nodes: PredicateNode[]
    Failed:
        result: ParseResult
