import tokenize from ./lexer
import integer_value, text_value, boolean_value from ./value
import type Value from ./value.types
import type IndexAccessErrors, AllocationErrors from standard.errors
import type LexResult, Token, TokenKind from ./lexer.types
import type ParseResult, ParseErrorKind, Statement, LiteralParse, ComparisonOperator, PredicateNode, PredicateProgress, RowLimit from ./query.types
import type Column, ColumnType from ./schema.types

let syntax_failure = f(token: Token, kind: ParseErrorKind, detail: string): ParseResult =>
    return new ParseResult.SyntaxFailure:
        kind: kind
        position: token.position
        detail: detail

let expected = f(token: Token, kind: ParseErrorKind, description: string): ParseResult =>
    if token.kind is TokenKind.EndOfInput:
        return syntax_failure(
                token,
                new ParseErrorKind.UnexpectedEndOfInput,
                'expected {description}'
            )
    return syntax_failure(token, kind, 'expected {description}')

# Check the query terminator here, after the statement-specific grammar.

let finish_statement = f(
    ref tokens: Token[],
    index: int64,
    statement: Statement
): ParseResult errors IndexAccessErrors =>
    let semicolon: Token = propagate tokens.at(index)
    if semicolon.kind is not TokenKind.Semicolon:
        return expected(semicolon, new ParseErrorKind.UnexpectedToken, ';')
    let end: Token = propagate tokens.at(index + 1)
    if end.kind is not TokenKind.EndOfInput:
        return expected(end, new ParseErrorKind.UnexpectedToken, 'end of input')
    let result: ParseResult = new ParseResult.Parsed:
        statement: statement
    return result

let parse_create = f(ref tokens: Token[]): ParseResult errors IndexAccessErrors =>
    let table_keyword: Token = propagate tokens.at(1)
    if table_keyword.kind is not TokenKind.Table:
        return expected(table_keyword, new ParseErrorKind.UnexpectedToken, 'TABLE')
    let table_name_token: Token = propagate tokens.at(2)
    let table_name_kind: TokenKind = table_name_token.kind
    let mutable table_name = ''
    if table_name_kind is TokenKind.Identifier into table_identifier:
        table_name = table_identifier.name
    else:
        return expected(table_name_token, new ParseErrorKind.InvalidIdentifier, 'table name')
    let open_token: Token = propagate tokens.at(3)
    if open_token.kind is not TokenKind.OpenParen:
        return expected(open_token, new ParseErrorKind.UnexpectedToken, '(')
    let mutable index: int64 = 4
    let mutable columns: Column[] = []
    while true:
        let name_token: Token = propagate tokens.at(index)
        let name_kind: TokenKind = name_token.kind
        let mutable name = ''
        if name_kind is TokenKind.Identifier into identifier:
            name = identifier.name
        else:
            return expected(name_token, new ParseErrorKind.InvalidIdentifier, 'column name')
        let type_token: Token = propagate tokens.at(index + 1)
        let mutable column_type: ColumnType = new ColumnType.Integer
        if type_token.kind is TokenKind.TextType:
            column_type = new ColumnType.Text
        else:
            if type_token.kind is TokenKind.BoolType:
                column_type = new ColumnType.Boolean
            else:
                if type_token.kind is not TokenKind.IntType:
                    return expected(
                            type_token,
                            new ParseErrorKind.UnsupportedDataType,
                            'INT, TEXT, or BOOL'
                        )
        let column: Column = new Column:
            name: name
            column_type: column_type
        columns.push(column)
        let separator: Token = propagate tokens.at(index + 2)
        if separator.kind is TokenKind.CloseParen:
            let statement: Statement = new Statement.CreateTable:
                name: table_name
                columns: columns
            return propagate finish_statement(ref tokens, index + 3, statement)
        if separator.kind is not TokenKind.Comma:
            return expected(separator, new ParseErrorKind.UnexpectedToken, ', or )')
        index = index + 3

let parse_literal = f(kind: TokenKind): LiteralParse =>
    if kind is TokenKind.IntegerLiteral into literal:
        return new LiteralParse.Literal:
            value: integer_value(literal.value)
    if kind is TokenKind.StringLiteral into literal:
        return new LiteralParse.Literal:
            value: text_value(literal.value)
    if kind is TokenKind.BooleanLiteral into literal:
        return new LiteralParse.Literal:
            value: boolean_value(literal.value)
    return new LiteralParse.NotLiteral

let parse_insert = f(ref tokens: Token[]): ParseResult errors IndexAccessErrors =>
    let into_keyword: Token = propagate tokens.at(1)
    if into_keyword.kind is not TokenKind.Into:
        return expected(into_keyword, new ParseErrorKind.UnexpectedToken, 'INTO')
    let table_token: Token = propagate tokens.at(2)
    let table_kind: TokenKind = table_token.kind
    let mutable table_name: string = ''
    if table_kind is TokenKind.Identifier into identifier:
        table_name = identifier.name
    else:
        return expected(table_token, new ParseErrorKind.InvalidIdentifier, 'table name')
    let values_keyword: Token = propagate tokens.at(3)
    if values_keyword.kind is not TokenKind.Values:
        return expected(values_keyword, new ParseErrorKind.UnexpectedToken, 'VALUES')
    let open_token: Token = propagate tokens.at(4)
    if open_token.kind is not TokenKind.OpenParen:
        return expected(open_token, new ParseErrorKind.UnexpectedToken, '(')
    let mutable index: int64 = 5
    let mutable values: Value[] = []
    while true:
        let token: Token = propagate tokens.at(index)
        let parsed: LiteralParse = parse_literal(token.kind)
        if parsed is LiteralParse.Literal into literal:
            let value: Value = literal.value
            values.push(value)
        else:
            return expected(token, new ParseErrorKind.UnexpectedToken, 'literal')
        let separator: Token = propagate tokens.at(index + 1)
        if separator.kind is TokenKind.CloseParen:
            let statement: Statement = new Statement.Insert:
                name: table_name
                values: values
            return propagate finish_statement(ref tokens, index + 2, statement)
        if separator.kind is not TokenKind.Comma:
            return expected(separator, new ParseErrorKind.UnexpectedToken, ', or )')
        index = index + 2

let predicate_failed = f(result: ParseResult): PredicateProgress =>
    return new PredicateProgress.Failed:
        result: result

let predicate_done = f(next: int64, root: int64, nodes: PredicateNode[]): PredicateProgress =>
    return new PredicateProgress.Done:
        next: next
        root: root
        nodes: nodes

let parse_comparison = f(ref tokens: Token[], start: int64, initial_nodes: PredicateNode[]): PredicateProgress errors IndexAccessErrors =>
    let column_token: Token = propagate tokens.at(start)
    let column_kind: TokenKind = column_token.kind
    let mutable name: string = ''
    if column_kind is TokenKind.Identifier into identifier:
        name = identifier.name
    else:
        return predicate_failed(expected(column_token, new ParseErrorKind.InvalidIdentifier, 'predicate column name'))
    let operator_token: Token = propagate tokens.at(start + 1)
    let kind: TokenKind = operator_token.kind
    if kind is not TokenKind.Equal and kind is not TokenKind.NotEqual and kind is not TokenKind.Less and kind is not TokenKind.LessEqual and kind is not TokenKind.Greater and kind is not TokenKind.GreaterEqual:
        return predicate_failed(expected(operator_token, new ParseErrorKind.UnexpectedToken, 'comparison operator'))
    let mutable operator: ComparisonOperator = new ComparisonOperator.Equal
    if kind is TokenKind.NotEqual:
        operator = new ComparisonOperator.NotEqual
    if kind is TokenKind.Less:
        operator = new ComparisonOperator.Less
    if kind is TokenKind.LessEqual:
        operator = new ComparisonOperator.LessEqual
    if kind is TokenKind.Greater:
        operator = new ComparisonOperator.Greater
    if kind is TokenKind.GreaterEqual:
        operator = new ComparisonOperator.GreaterEqual
    let literal_token: Token = propagate tokens.at(start + 2)
    let literal: LiteralParse = parse_literal(literal_token.kind)
    if literal is LiteralParse.Literal into parsed:
        let comparison: PredicateNode = new PredicateNode.Compare:
            column: name
            operator: operator
            value: parsed.value
        let mutable nodes: PredicateNode[] = initial_nodes
        let root: int64 = nodes.length
        nodes.push(comparison)
        return predicate_done(start + 3, root, nodes)
    return predicate_failed(expected(literal_token, new ParseErrorKind.UnexpectedToken, 'literal'))

let boolean_precedence = f(kind: TokenKind): int64 =>
    if kind is TokenKind.And:
        return 2
    if kind is TokenKind.Or:
        return 1
    return 0

# Precedence climbing emits postorder nodes. Grouping depth limits parser recursion;
# the node cap also bounds evaluator recursion for long, unparenthesized chains.
let parse_expression = f(ref tokens: Token[], start: int64, minimum: int64, depth: int64, initial_nodes: PredicateNode[]): PredicateProgress errors IndexAccessErrors =>
    let first: Token = propagate tokens.at(start)
    if depth >= 64 or initial_nodes.length >= 256:
        return predicate_failed(syntax_failure(first, new ParseErrorKind.PredicateTooComplex, 'predicate exceeds the nesting or node limit'))
    let mutable index: int64 = start
    let mutable root: int64 = -1
    let mutable nodes: PredicateNode[] = []
    if first.kind is TokenKind.OpenParen:
        let inner: PredicateProgress = propagate parse_expression(ref tokens, index + 1, 1, depth + 1, initial_nodes)
        if inner is PredicateProgress.Done into grouped:
            let ending: Token = propagate tokens.at(grouped.next)
            if ending.kind is not TokenKind.CloseParen:
                return predicate_failed(expected(ending, new ParseErrorKind.UnexpectedToken, ')'))
            let grouped_nodes: PredicateNode[] = grouped.nodes
            nodes = grouped_nodes
            root = grouped.root
            index = grouped.next + 1
        else:
            return inner
    else:
        let comparison: PredicateProgress = propagate parse_comparison(ref tokens, index, initial_nodes)
        if comparison is PredicateProgress.Done into parsed:
            let parsed_nodes: PredicateNode[] = parsed.nodes
            nodes = parsed_nodes
            root = parsed.root
            index = parsed.next
        else:
            return comparison
    while true:
        let connective: Token = propagate tokens.at(index)
        let precedence: int64 = boolean_precedence(connective.kind)
        if precedence < minimum:
            return predicate_done(index, root, nodes)
        let right: PredicateProgress = propagate parse_expression(ref tokens, index + 1, precedence + 1, depth + 1, nodes)
        if right is PredicateProgress.Done into operand:
            let operand_nodes: PredicateNode[] = operand.nodes
            nodes = operand_nodes
            if nodes.length >= 256:
                return predicate_failed(syntax_failure(connective, new ParseErrorKind.PredicateTooComplex, 'predicate exceeds the node limit'))
            let next_root: int64 = nodes.length
            if connective.kind is TokenKind.And:
                let combined: PredicateNode = new PredicateNode.And:
                    left: root
                    right: operand.root
                nodes.push(combined)
            else:
                let combined: PredicateNode = new PredicateNode.Or:
                    left: root
                    right: operand.root
                nodes.push(combined)
            root = next_root
            index = operand.next
        else:
            return right

let parse_optional_predicate = f(ref tokens: Token[], index: int64): PredicateProgress errors IndexAccessErrors =>
    let token: Token = propagate tokens.at(index)
    let nodes: PredicateNode[] = []
    if token.kind is TokenKind.Where:
        return propagate parse_expression(ref tokens, index + 1, 1, 0, nodes)
    return predicate_done(index, -1, nodes)

let parse_select = f(ref tokens: Token[]): ParseResult errors IndexAccessErrors =>
    let first: Token = propagate tokens.at(1)
    let wildcard: boolean = first.kind is TokenKind.Asterisk
    let mutable requested: string[] = []
    let mutable index: int64 = 2
    if not wildcard:
        index = 1
        let mutable next_column = true
        while next_column:
            let column: Token = propagate tokens.at(index)
            let kind: TokenKind = column.kind
            if kind is TokenKind.Identifier into identifier:
                requested.push(identifier.name)
            else:
                return expected(column, new ParseErrorKind.InvalidIdentifier, 'column name')
            index = index + 1
            let separator: Token = propagate tokens.at(index)
            next_column = separator.kind is TokenKind.Comma
            if next_column:
                index = index + 1
    let source: Token = propagate tokens.at(index)
    if source.kind is not TokenKind.From:
        return expected(source, new ParseErrorKind.UnexpectedToken, 'FROM')
    let table: Token = propagate tokens.at(index + 1)
    let kind: TokenKind = table.kind
    if kind is TokenKind.Identifier into identifier:
        let expression: PredicateProgress = propagate parse_optional_predicate(ref tokens, index + 2)
        if expression is PredicateProgress.Failed into failed:
            let failure: ParseResult = failed.result
            return failure
        if expression is PredicateProgress.Done into parsed:
            let predicate: PredicateNode[] = parsed.nodes
            let mutable next: int64 = parsed.next
            let mutable limit: RowLimit = new RowLimit.Unlimited
            let after_predicate: Token = propagate tokens.at(next)
            if after_predicate.kind is TokenKind.Limit:
                let count_token: Token = propagate tokens.at(next + 1)
                let count_kind: TokenKind = count_token.kind
                if count_kind is TokenKind.IntegerLiteral into count:
                    if count.value < 0:
                        return expected(count_token, new ParseErrorKind.InvalidLimit, 'nonnegative row limit')
                    limit = new RowLimit.AtMost:
                        rows: count.value
                    next = next + 2
                else:
                    return expected(count_token, new ParseErrorKind.InvalidLimit, 'nonnegative row limit')
            if wildcard:
                let statement: Statement = new Statement.SelectAll:
                    name: identifier.name
                    predicate: predicate
                    limit: limit
                return propagate finish_statement(ref tokens, next, statement)
            let statement: Statement = new Statement.SelectColumns:
                name: identifier.name
                columns: requested
                predicate: predicate
                limit: limit
            return propagate finish_statement(ref tokens, next, statement)
    return expected(table, new ParseErrorKind.InvalidIdentifier, 'table name')

##
  Description: Parses a complete token stream returned by the tokenizer.
##
public let parse_tokens = f(ref tokens: Token[]): ParseResult errors IndexAccessErrors =>
    let first: Token = propagate tokens.at(0)
    if first.kind is TokenKind.Create:
        return propagate parse_create(ref tokens)
    if first.kind is TokenKind.Insert:
        return propagate parse_insert(ref tokens)
    if first.kind is TokenKind.Select:
        return propagate parse_select(ref tokens)
    return expected(first, new ParseErrorKind.UnexpectedToken, 'CREATE TABLE, INSERT, or SELECT')

##
  Description: Parses one terminated query without inspecting database state.
##
public let parse_query = f(text: string): ParseResult errors IndexAccessErrors, AllocationErrors =>
    let lexical: LexResult = propagate tokenize(text)
    if lexical is LexResult.Success into success:
        let tokens: Token[] = success.tokens
        return propagate parse_tokens(ref tokens)
    if lexical is LexResult.Failure into failure:
        let result: ParseResult = new ParseResult.LexicalFailure:
            kind: failure.kind
            position: failure.position
            detail: failure.detail
        return result
