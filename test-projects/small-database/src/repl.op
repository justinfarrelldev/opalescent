import string_is_blank, string_join, take_input, print_text_sync, flush_standard_output_sync from standard
import type IndexAccessErrors, AllocationErrors, StdoutWriterErrors from standard.errors
import empty_database, execute_create, execute_insert, execute_select_all, execute_select_columns from ./database
import tokenize from ./lexer
import parse_tokens from ./parser
import format_selection, format_schema from ./formatting
import type LexResult, Token, TokenKind, SourcePosition from ./lexer.types
import type ParseResult, Statement from ./query.types
import type Database, Creation, CreateResult, Insertion, InsertResult, SelectResult, Table from ./database.types
import type Column from ./schema.types
import type Value from ./value.types

let show_syntax_error = f(line: int64, column: int64, detail: string): void =>
    print('Query error at {line}:{column}: {detail}')
    return void

let create_table = f(database: Database, name: string, ref columns: Column[]): Database errors IndexAccessErrors =>
    let outcome: Creation = propagate execute_create(database, name, ref columns)
    let result: CreateResult = outcome.result
    if result is CreateResult.Created into created:
        print('Table \'{created.name}\' created.')
    if result is CreateResult.DuplicateTable into duplicate:
        print('DuplicateTable: table \'{duplicate.name}\' already exists.')
    if result is CreateResult.DuplicateColumn into duplicate:
        print('DuplicateColumn: column \'{duplicate.column_name}\' is repeated in table \'{duplicate.table_name}\'.')
    if result is CreateResult.EmptySchema into empty:
        print('EmptySchema: table \'{empty.table_name}\' must have at least one column.')
    let state: Database = outcome.state
    return state

let insert_row = f(database: Database, name: string, ref values: Value[]): Database errors IndexAccessErrors =>
    let outcome: Insertion = propagate execute_insert(database, name, ref values)
    let result: InsertResult = outcome.result
    if result is InsertResult.Inserted into inserted:
        print('{inserted.count} row inserted.')
    if result is InsertResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is InsertResult.IncorrectValueCount into mismatch:
        print('IncorrectValueCount: table \'{mismatch.table_name}\' expects {mismatch.expected} values, received {mismatch.actual}.')
    if result is InsertResult.TypeMismatch into mismatch:
        print('TypeMismatch: value for column \'{mismatch.column_name}\' does not match its type in table \'{mismatch.table_name}\'.')
    let state: Database = outcome.state
    return state

let show_selection = f(result: SelectResult): void errors IndexAccessErrors, AllocationErrors =>
    if result is SelectResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is SelectResult.UnknownColumn into missing:
        print('UnknownColumn: column \'{missing.column_name}\' does not exist in table \'{missing.table_name}\'.')
    if result is SelectResult.Selected into selected:
        let columns: Column[] = selected.columns
        let rows: Value[][] = selected.rows
        let lines: string[] = propagate format_selection(ref columns, ref rows)
        for line in lines:
            print(line)
    return void

let show_tables = f(ref database: Database): void errors IndexAccessErrors, AllocationErrors =>
    let tables: Table[] = database.tables
    if tables.length is 0:
        print('No tables.')
        return void
    let mutable names: string[] = []
    let mutable index: int64 = 0
    while index < tables.length:
        let table: Table = propagate tables.at(index)
        names.push(table.name)
        index = index + 1
    let summary: string = propagate string_join(names, ', ')
    print('Tables: {summary}')
    return void

let describe_table = f(ref database: Database, name: string): void errors IndexAccessErrors, AllocationErrors =>
    let result: SelectResult = propagate execute_select_all(ref database, name)
    if result is SelectResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is SelectResult.Selected into selected:
        let columns: Column[] = selected.columns
        let schema: string = propagate format_schema(ref columns)
        print(schema)
    return void

let handle_introspection = f(ref database: Database, ref tokens: Token[]): boolean errors IndexAccessErrors, AllocationErrors =>
    if tokens.length is 3:
        let first: Token = propagate tokens.at(0)
        let semicolon: Token = propagate tokens.at(1)
        if first.kind is TokenKind.Help and semicolon.kind is TokenKind.Semicolon:
            print('Available commands: CREATE TABLE, INSERT INTO, SELECT, SHOW TABLES, DESCRIBE, HELP, QUIT.')
            return true
    if tokens.length is 4:
        let first: Token = propagate tokens.at(0)
        let argument: Token = propagate tokens.at(1)
        let semicolon: Token = propagate tokens.at(2)
        if semicolon.kind is TokenKind.Semicolon:
            if first.kind is TokenKind.Show and argument.kind is TokenKind.Tables:
                propagate show_tables(ref database)
                return true
            if first.kind is TokenKind.Describe:
                let kind: TokenKind = argument.kind
                if kind is TokenKind.Identifier into identifier:
                    propagate describe_table(ref database, identifier.name)
                    return true
    return false

let execute_query = f(database: Database, ref tokens: Token[]): Database errors IndexAccessErrors, AllocationErrors =>
    let handled: boolean = propagate handle_introspection(ref database, ref tokens)
    if handled:
        return database
    let query: ParseResult = propagate parse_tokens(ref tokens)
    if query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        if statement is Statement.CreateTable into create:
            let columns: Column[] = create.columns
            return propagate create_table(database, create.name, ref columns)
        if statement is Statement.Insert into insert:
            let values: Value[] = insert.values
            return propagate insert_row(database, insert.name, ref values)
        if statement is Statement.SelectAll into select:
            let result: SelectResult = propagate execute_select_all(ref database, select.name)
            propagate show_selection(result)
        if statement is Statement.SelectColumns into select:
            let columns: string[] = select.columns
            let result: SelectResult = propagate execute_select_columns(ref database, select.name, ref columns)
            propagate show_selection(result)
    if query is ParseResult.SyntaxFailure into failure:
        let position: SourcePosition = failure.position
        show_syntax_error(position.line, position.column, failure.detail)
    return database

let is_quit = f(ref tokens: Token[]): boolean errors IndexAccessErrors =>
    if tokens.length is not 3:
        return false
    let command: Token = propagate tokens.at(0)
    let terminator: Token = propagate tokens.at(1)
    return command.kind is TokenKind.Quit and terminator.kind is TokenKind.Semicolon

##
  Description: Prompts for, parses, and executes one statement per input line.
##
public let run_repl = f(): void errors IndexAccessErrors, AllocationErrors, StdoutWriterErrors =>
    let mutable database: Database = empty_database()
    print('Opalescent Database')
    print('Type HELP; for available commands.')
    let finished =
        loop =>
            propagate print_text_sync('db> ')
            propagate flush_standard_output_sync()
            guard take_input() into line else err =>
                break finished: true
            if string_is_blank(line):
                continue
            let lexical: LexResult = propagate tokenize(line)
            if lexical is LexResult.Failure into failure:
                let position: SourcePosition = failure.position
                show_syntax_error(position.line, position.column, failure.detail)
                continue
            if lexical is LexResult.Success into success:
                let tokens: Token[] = success.tokens
                let quitting: boolean = propagate is_quit(ref tokens)
                if quitting:
                    break finished: true
                database = propagate execute_query(database, ref tokens)
    if finished:
        print('Goodbye.')
    return void
