import string_is_blank, string_join, take_input, print_text_sync, flush_standard_output_sync, path_from, path_exists_sync from standard
import exit_process from process
import restore_database, persist_database from ./persistence
import type SnapshotResult, SaveResult from ./persistence.types
import type IndexAccessErrors, AllocationErrors, StdoutWriterErrors, FilesystemPathErrors from standard.errors
import empty_database, execute_create, execute_insert, execute_select_all, execute_select_where, execute_delete, execute_update from ./database
import tokenize from ./lexer
import parse_tokens from ./parser
import format_selection, format_schema, type_label from ./formatting
import type LexResult, LexErrorKind, Token, TokenKind, SourcePosition from ./lexer.types
import type ParseResult, Statement, PredicateNode, Assignment from ./query.types
import type PredicateError from ./predicate.types
import type Database, Creation, CreateResult, Insertion, InsertResult, SelectResult, Table, Mutation, MutationResult from ./database.types
import type Column from ./schema.types
import type Value from ./value.types

let lex_error_label = f(kind: LexErrorKind): string =>
    if kind is LexErrorKind.UnexpectedCharacter:
        return 'UnexpectedCharacter'
    if kind is LexErrorKind.InvalidIntegerLiteral:
        return 'InvalidIntegerLiteral'
    if kind is LexErrorKind.IntegerOverflow:
        return 'IntegerOverflow'
    if kind is LexErrorKind.UnterminatedString:
        return 'UnterminatedString'
    return 'InvalidEscape'

let show_syntax_error = f(line: int64, column: int64, detail: string): void =>
    print('Query error at {line}:{column}: {detail}')
    return void

let create_table = f(database: Database, name: string, ref columns: Column[]): Database errors IndexAccessErrors =>
    let outcome: Creation = propagate execute_create(database, name, ref columns)
    let result: CreateResult = outcome.result
    if result is CreateResult.Created into created:
        print('Table \'{created.name}\' created.')
    if result is CreateResult.DuplicateTable into duplicate:
        print('DuplicateTable: table \'{duplicate.name}\' already exists.')
    if result is CreateResult.DuplicateColumn into duplicate:
        print('DuplicateColumn: column \'{duplicate.column_name}\' is repeated in table \'{duplicate.table_name}\'.')
    if result is CreateResult.EmptySchema into empty:
        print('EmptySchema: table \'{empty.table_name}\' must have at least one column.')
    let state: Database = outcome.state
    return state

let insert_row = f(database: Database, name: string, ref values: Value[]): Database errors IndexAccessErrors =>
    let outcome: Insertion = propagate execute_insert(database, name, ref values)
    let result: InsertResult = outcome.result
    if result is InsertResult.Inserted into inserted:
        print('{inserted.count} row inserted.')
    if result is InsertResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is InsertResult.IncorrectValueCount into mismatch:
        print('IncorrectValueCount: table \'{mismatch.table_name}\' expects {mismatch.expected} values, received {mismatch.actual}.')
    if result is InsertResult.TypeMismatch into mismatch:
        print('TypeMismatch: value for column \'{mismatch.column_name}\' does not match its type in table \'{mismatch.table_name}\'.')
    let state: Database = outcome.state
    return state

let show_predicate_error = f(table: string, problem: PredicateError): void =>
    if problem is PredicateError.UnknownColumn into missing:
        print('UnknownColumn: column \'{missing.name}\' does not exist in table \'{table}\'.')
    if problem is PredicateError.TypeMismatch into mismatch:
        let label: string = type_label(mismatch.expected)
        print('TypeMismatch: comparison with \'{table}.{mismatch.name}\' expects {label}.')
    if problem is PredicateError.UnsupportedOperator into unsupported:
        let label: string = type_label(unsupported.column_type)
        print('UnsupportedOperator: column \'{table}.{unsupported.name}\' of type {label} supports only equality and inequality.')
    return void

let show_mutation = f(outcome: Mutation): Database =>
    let result: MutationResult = outcome.result
    if result is MutationResult.Updated into updated:
        print('{updated.count} rows updated.')
    if result is MutationResult.Deleted into deleted:
        print('{deleted.count} rows deleted.')
    if result is MutationResult.UnknownColumn into missing:
        print('UnknownColumn: column \'{missing.column_name}\' does not exist in table \'{missing.table_name}\'.')
    if result is MutationResult.AssignmentTypeMismatch into mismatch:
        print('TypeMismatch: assignment to \'{mismatch.table_name}.{mismatch.column_name}\' must match its declared type.')
    if result is MutationResult.DuplicateAssignment into duplicate:
        print('DuplicateAssignment: \'{duplicate.table_name}.{duplicate.column_name}\' is assigned more than once.')
    if result is MutationResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is MutationResult.InvalidPredicate into invalid:
        show_predicate_error(invalid.table_name, invalid.problem)
    let state: Database = outcome.state
    return state

let show_selection = f(result: SelectResult): void errors IndexAccessErrors, AllocationErrors =>
    if result is SelectResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is SelectResult.UnknownColumn into missing:
        print('UnknownColumn: column \'{missing.column_name}\' does not exist in table \'{missing.table_name}\'.')
    if result is SelectResult.InvalidPredicate into invalid:
        show_predicate_error(invalid.table_name, invalid.problem)
    if result is SelectResult.Selected into selected:
        let columns: Column[] = selected.columns
        let rows: Value[][] = selected.rows
        let lines: string[] = propagate format_selection(ref columns, ref rows)
        for line in lines:
            print(line)
    return void

let show_tables = f(ref database: Database): void errors IndexAccessErrors, AllocationErrors =>
    let tables: Table[] = database.tables
    if tables.length is 0:
        print('No tables.')
        return void
    let mutable names: string[] = []
    let mutable index: int64 = 0
    while index < tables.length:
        let table: Table = propagate tables.at(index)
        names.push(table.name)
        index = index + 1
    let summary: string = propagate string_join(names, ', ')
    print('Tables: {summary}')
    return void

let describe_table = f(ref database: Database, name: string): void errors IndexAccessErrors, AllocationErrors =>
    let result: SelectResult = propagate execute_select_all(ref database, name)
    if result is SelectResult.UnknownTable into missing:
        print('UnknownTable: table \'{missing.name}\' does not exist.')
    if result is SelectResult.Selected into selected:
        let columns: Column[] = selected.columns
        let schema: string = propagate format_schema(ref columns)
        print(schema)
    return void

let handle_introspection = f(ref database: Database, ref tokens: Token[]): boolean errors IndexAccessErrors, AllocationErrors =>
    if tokens.length is 3:
        let first: Token = propagate tokens.at(0)
        let semicolon: Token = propagate tokens.at(1)
        if first.kind is TokenKind.Help and semicolon.kind is TokenKind.Semicolon:
            print('Available commands: CREATE TABLE, INSERT INTO, SELECT, UPDATE, DELETE FROM, SHOW TABLES, DESCRIBE, SAVE, LOAD, HELP, QUIT.')
            print('SAVE replaces the configured snapshot. LOAD replaces the active database, discarding unsaved changes.')
            print('QUIT and EOF never save automatically.')
            return true
    if tokens.length is 4:
        let first: Token = propagate tokens.at(0)
        let argument: Token = propagate tokens.at(1)
        let semicolon: Token = propagate tokens.at(2)
        if semicolon.kind is TokenKind.Semicolon:
            if first.kind is TokenKind.Show and argument.kind is TokenKind.Tables:
                propagate show_tables(ref database)
                return true
            if first.kind is TokenKind.Describe:
                let kind: TokenKind = argument.kind
                if kind is TokenKind.Identifier into identifier:
                    propagate describe_table(ref database, identifier.name)
                    return true
    return false

let execute_query = f(database: Database, ref tokens: Token[]): Database errors IndexAccessErrors, AllocationErrors =>
    let handled: boolean = propagate handle_introspection(ref database, ref tokens)
    if handled:
        return database
    let query: ParseResult = propagate parse_tokens(ref tokens)
    if query is ParseResult.Parsed into parsed:
        let statement: Statement = parsed.statement
        if statement is Statement.CreateTable into create:
            let columns: Column[] = create.columns
            return propagate create_table(database, create.name, ref columns)
        if statement is Statement.Insert into insert:
            let values: Value[] = insert.values
            return propagate insert_row(database, insert.name, ref values)
        if statement is Statement.Update into update:
            let assignments: Assignment[] = update.assignments
            let predicate: PredicateNode[] = update.predicate
            let outcome: Mutation = propagate execute_update(database, update.name, ref assignments, ref predicate)
            return show_mutation(outcome)
        if statement is Statement.Delete into delete:
            let predicate: PredicateNode[] = delete.predicate
            let outcome: Mutation = propagate execute_delete(database, delete.name, ref predicate)
            return show_mutation(outcome)
        if statement is Statement.SelectAll into select:
            let columns: string[] = []
            let predicate: PredicateNode[] = select.predicate
            let result: SelectResult = propagate execute_select_where(ref database, select.name, ref columns, ref predicate, select.limit)
            propagate show_selection(result)
        if statement is Statement.SelectColumns into select:
            let columns: string[] = select.columns
            let predicate: PredicateNode[] = select.predicate
            let result: SelectResult = propagate execute_select_where(ref database, select.name, ref columns, ref predicate, select.limit)
            propagate show_selection(result)
    if query is ParseResult.SyntaxFailure into failure:
        let position: SourcePosition = failure.position
        show_syntax_error(position.line, position.column, failure.detail)
    return database

let is_quit = f(ref tokens: Token[]): boolean errors IndexAccessErrors =>
    if tokens.length is not 3:
        return false
    let command: Token = propagate tokens.at(0)
    let terminator: Token = propagate tokens.at(1)
    return command.kind is TokenKind.Quit and terminator.kind is TokenKind.Semicolon

let report_load_failure = f(result: SnapshotResult): void =>
    if result is SnapshotResult.InvalidSnapshot into invalid:
        print('InvalidSnapshot at line {invalid.line}: {invalid.detail}')
    if result is SnapshotResult.UnsupportedVersion into unsupported:
        print('UnsupportedVersion: snapshot version {unsupported.version} is not supported.')
    if result is SnapshotResult.FilesystemFailure into failure:
        print('FilesystemFailure: {failure.detail}')
    return void

let save_active = f(database: Database, filename: string): Database =>
    let result: SaveResult = persist_database(path_from(filename), ref database)
    if result is SaveResult.Saved into saved:
        print('Database saved.')
        let state: Database = saved.database
        return state
    if result is SaveResult.Failed into failure:
        print('FilesystemFailure: {failure.detail}')
    return database

let load_active = f(database: Database, filename: string): Database =>
    let result: SnapshotResult = restore_database(path_from(filename))
    if result is SnapshotResult.Loaded into loaded:
        print('Database loaded.')
        let state: Database = loaded.database
        return state
    report_load_failure(result)
    return database

let execute_line = f(database: Database, ref tokens: Token[], filename: string): Database errors IndexAccessErrors, AllocationErrors =>
    if tokens.length is 3:
        let first: Token = propagate tokens.at(0)
        let semicolon: Token = propagate tokens.at(1)
        if semicolon.kind is TokenKind.Semicolon and (first.kind is TokenKind.Save or first.kind is TokenKind.Load):
            if filename is '':
                print('FilesystemFailure: no snapshot filename configured.')
                return database
            if first.kind is TokenKind.Save:
                return save_active(database, filename)
            return load_active(database, filename)
    return propagate execute_query(database, ref tokens)

##
  Description: Loads an existing snapshot, then prompts for one statement per input line.
##
public let run_repl = f(filename: string): void errors IndexAccessErrors, AllocationErrors, StdoutWriterErrors, FilesystemPathErrors =>
    let mutable database: Database = empty_database()
    if filename is not '':
        let path: FilesystemPath = path_from(filename)
        let exists: boolean = propagate path_exists_sync(path)
        if exists:
            let result: SnapshotResult = restore_database(path)
            if result is SnapshotResult.Loaded into loaded:
                let state: Database = loaded.database
                database = state
            else:
                report_load_failure(result)
                exit_process(1)
                return void
    print('Opalescent Database')
    print('Type HELP; for available commands.')
    let finished =
        loop =>
            if database.dirty:
                propagate print_text_sync('db*> ')
            else:
                propagate print_text_sync('db> ')
            propagate flush_standard_output_sync()
            guard take_input() into line else err =>
                break finished: true
            if string_is_blank(line):
                continue
            let lexical: LexResult = propagate tokenize(line)
            if lexical is LexResult.Failure into failure:
                let position: SourcePosition = failure.position
                let label: string = lex_error_label(failure.kind)
                print('{label} at {position.line}:{position.column}: {failure.detail}')
                continue
            if lexical is LexResult.Success into success:
                let tokens: Token[] = success.tokens
                let quitting: boolean = propagate is_quit(ref tokens)
                if quitting:
                    break finished: true
                database = propagate execute_line(database, ref tokens, filename)
    if finished:
        if filename is not '' and database.dirty:
            print('Discarding unsaved changes.')
        print('Goodbye.')
    return void
