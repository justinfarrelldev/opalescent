import terminal_session_options_default, terminal_session_open_sync from 'standard.terminal'
import terminal_session_clear_screen_sync, terminal_session_move_cursor_sync from 'standard.terminal'
import terminal_session_draw_rows_sync, terminal_session_bell_sync from 'standard.terminal'
import terminal_session_flush_sync, terminal_session_close_sync from 'standard.terminal'
import trusted_terminal_output_from_application_text from 'standard.terminal'
import type TerminalSessionOpenError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, TrustedTerminalOutput from 'standard.terminal'

##
  Description: Generated terminal rendering fixture for fake-backend high-level session operations.
##
entry main = f(args: string[]): void errors TerminalSessionOpenError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, InvalidCursorPositionError, AllocationFailureError =>
    let options = terminal_session_options_default()
    let mutable session = propagate terminal_session_open_sync(options)
    let row_a = propagate trusted_terminal_output_from_application_text('alpha')
    let row_b = propagate trusted_terminal_output_from_application_text('beta')
    let rows: TrustedTerminalOutput[] = [row_a, row_b]
    propagate terminal_session_clear_screen_sync(mutable ref session)
    propagate terminal_session_move_cursor_sync(mutable ref session, 2 as int32, 3 as int32)
    propagate terminal_session_draw_rows_sync(mutable ref session, rows)
    propagate terminal_session_bell_sync(mutable ref session)
    propagate terminal_session_flush_sync(ref session)
    let _closed = propagate terminal_session_close_sync(mutable ref session)
    print('TERMINAL_RENDER_DONE')
    return void
