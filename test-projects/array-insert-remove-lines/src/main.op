##
  Description: Verifies method-style array insert and remove_at for editor line buffers.
##
entry main = f(args: string[]): void errors IndexOutOfBoundsError, AllocationFailureError =>
    let lines: string[] = ['alpha', 'gamma']
    let inserted = propagate lines.insert(1 as int64, 'beta')
    let updated, removed = propagate inserted.remove_at(0 as int64)

    print('inserted length {inserted.length}')
    print('inserted {propagate inserted.at(0)} {propagate inserted.at(1)} {propagate inserted.at(2)}')
    print('updated length {updated.length}')
    print('updated {propagate updated.at(0)} {propagate updated.at(1)}')
    print('removed {removed}')
    print('source length {lines.length}')
    print('source {propagate lines.at(0)} {propagate lines.at(1)}')
    return void
