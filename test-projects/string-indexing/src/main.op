import print from standard

##
    Description: minimal fixture proving string indexing and comparison
##
entry main = f(): void errors IndexOutOfBoundsError => {
    let message = 'aéf'
    let first: string = propagate message.at(0)
    let last: string = propagate message.at(message.length - 1)
    let unicode: string = propagate message.at(1)
    let condition_char: string = propagate message.at(0)

    print('first={first}')
    print('last={last}')
    print('unicode={unicode}')

    if condition_char is 'a' {
        print('condition=true')
    }

    return void
}
