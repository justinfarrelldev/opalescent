##
  Description: Runs the reduce red fixture for seeded array accumulation behavior.
##
entry main = f(args: string[]): void =>
    let xs: int32[] = [1, 2, 3]
    let initial_sum: int32 = 0
    let sum = xs.reduce(initial_sum, f(acc: int32, x: int32): int32 => acc + x)
    print('sum {sum}')
    let empty: int32[] = []
    let initial_seed: int32 = 99
    let seed = empty.reduce(initial_seed, f(acc: int32, x: int32): int32 => acc + x)
    print('empty {seed}')
    return void
