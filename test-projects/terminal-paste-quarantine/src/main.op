import terminal_session_options_default, terminal_session_open_sync, terminal_session_read_event_sync, terminal_session_write_sync, terminal_session_flush_sync, terminal_session_close_sync from standard
import trusted_terminal_output_from_application_text, cancellation_source_new, cancellation_token from standard
import type TerminalWait, TerminalInputEvent, TerminalLogicalKey, TerminalNamedKey, TerminalInputResetReason, TerminalTextInputOrigin, TerminalPastePhase, TerminalUnknownBytesReason, TerminalNativeEventKind, TerminalMouseTracking, TerminalOrdinaryFeature, TerminalSessionOptionsError, TerminalSessionOpenError, TerminalSessionReadError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, TerminalChordValidationError, TerminalChordProcessError, TerminalChordPriority, TerminalChordTrigger, TerminalChordTextPolicy, TerminalChordRouterPolicy, TerminalChordRouterOutput, TerminalChordReleasedInput, TerminalChordKey, TerminalControlCode, TerminalChordPrefixPolicy, TerminalLockModifierMask, TerminalChordBindingId, TerminalChordMutationError, TerminalChordResetReason from standard

# Deterministic input plan: TextInput('typed'), Paste('trusted paste', Complete, trusted evidence), UnknownBytes(PasteInvalidUtf8), UnknownBytes(UnrecognizedSequence), InputReset(PasteFallback), EndOfInput.
# Deterministic fault plan: malformed trusted paste fallback emits only UnknownBytes before exactly one PasteFallback reset; unknown bytes and malformed bytes are quarantined and never routed as commands.
# Expected final summary: PASTE_QUARANTINE_SUMMARY direct_text=1 trusted_paste=1 quarantined_chunks=2 malformed_chunks=1 unknown_chunks=1 paste_fallback_resets=1 command_activations=0 status=ok

##
  Description: Selected typed-event-session fixture distinguishing trusted paste chunks from quarantined malformed and unknown bytes.
##
entry main = f(args: string[]): void errors TerminalSessionOpenError, TerminalSessionReadError, TerminalSessionWriteError, TerminalSessionStateError, TerminalSessionRestoreError, AllocationFailureError =>
    let source = propagate cancellation_source_new()
    let token = cancellation_token(ref source)
    let options = terminal_session_options_default()
    let mutable session = propagate terminal_session_open_sync(options)

    let mutable direct_text: int64 = 0
    let mutable trusted_paste: int64 = 0
    let mutable quarantined_chunks: int64 = 0
    let mutable malformed_chunks: int64 = 0
    let mutable unknown_chunks: int64 = 0
    let mutable paste_fallback_resets: int64 = 0
    let mutable command_activations: int64 = 0
    let mutable running = true
    let mutable reads: int64 = 0

    while running and reads < 8:
        let event = propagate terminal_session_read_event_sync(mutable ref session, new TerminalWait.Poll, token)
        reads = reads + 1

        if event is TerminalInputEvent.TextInput:
            direct_text = direct_text + 1
        if event is TerminalInputEvent.Paste:
            trusted_paste = trusted_paste + 1
        if event is TerminalInputEvent.UnknownBytes:
            quarantined_chunks = quarantined_chunks + 1
            if quarantined_chunks is 1:
                malformed_chunks = malformed_chunks + 1
            else:
                unknown_chunks = unknown_chunks + 1
        if event is TerminalInputEvent.InputReset:
            paste_fallback_resets = paste_fallback_resets + 1
        if event is TerminalInputEvent.Key:
            command_activations = command_activations + 1
        if event is TerminalInputEvent.EndOfInput:
            running = false

    let summary = propagate trusted_terminal_output_from_application_text('PASTE_QUARANTINE_SUMMARY direct_text={direct_text} trusted_paste={trusted_paste} quarantined_chunks={quarantined_chunks} malformed_chunks={malformed_chunks} unknown_chunks={unknown_chunks} paste_fallback_resets={paste_fallback_resets} command_activations={command_activations} status=ok\n')
    propagate terminal_session_write_sync(ref session, summary)
    propagate terminal_session_flush_sync(ref session)
    let close_outcome = propagate terminal_session_close_sync(mutable ref session)
    return void
