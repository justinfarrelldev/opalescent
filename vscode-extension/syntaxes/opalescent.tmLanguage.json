{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Opalescent",
  "scopeName": "source.opalescent",
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#line-comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#type-block" },
    { "include": "#declarations" },
    { "include": "#errors-clause" },
    { "include": "#keyword" },
    { "include": "#type-name" },
    { "include": "#function-call" },
    { "include": "#identifier" }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.documentation.opalescent",
      "begin": "##",
      "end": "##",
      "patterns": [
        { "name": "comment.block.documentation.opalescent", "match": "." }
      ]
    },
    "line-comment": {
      "name": "comment.line.number-sign.opalescent",
      "match": "#(?!#).*$"
    },
    "string": {
      "name": "string.quoted.single.opalescent",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.opalescent",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.opalescent",
          "begin": "\\{",
          "end": "\\}",
          "contentName": "source.opalescent.embedded",
          "patterns": [
            { "include": "#number" },
            { "include": "#keyword" },
            { "include": "#function-call" },
            { "include": "#identifier" }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.opalescent",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.hex.opalescent",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.opalescent",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.opalescent",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.opalescent",
          "match": "\\b(public\\s+)?(let)\\s+(mutable\\s+)?([a-z_][A-Za-z0-9_]*)\\s*(?==\\s*f\\b)",
          "captures": {
            "1": { "name": "keyword.declaration.visibility.opalescent" },
            "2": { "name": "storage.type.let.opalescent" },
            "3": { "name": "storage.modifier.mutable.opalescent" },
            "4": { "name": "entity.name.function.opalescent" }
          }
        },
        {
          "name": "meta.let.declaration.opalescent",
          "match": "\\b(public\\s+)?(let)\\s+(mutable\\s+)?([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.visibility.opalescent" },
            "2": { "name": "storage.type.let.opalescent" },
            "3": { "name": "storage.modifier.mutable.opalescent" },
            "4": { "name": "variable.other.definition.opalescent" }
          }
        },
        {
          "name": "meta.entry.declaration.opalescent",
          "match": "\\b(entry)\\s+([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.entry.opalescent" },
            "2": { "name": "entity.name.function.entry.opalescent" }
          }
        },
        {
          "name": "meta.type.declaration.opalescent",
          "match": "\\b(public\\s+)?(type)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.visibility.opalescent" },
            "2": { "name": "keyword.declaration.type.opalescent" },
            "3": { "name": "entity.name.type.opalescent" }
          }
        },
        {
          "name": "meta.error-set.declaration.opalescent",
          "match": "\\b(public\\s+)?(error)\\s+(set)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.visibility.opalescent" },
            "2": { "name": "keyword.declaration.error.opalescent" },
            "3": { "name": "keyword.declaration.set.opalescent" },
            "4": { "name": "entity.name.type.error-set.opalescent" }
          }
        }
      ]
    },
    "errors-clause": {
      "name": "meta.errors-clause.opalescent",
      "begin": "\\berrors\\b",
      "beginCaptures": {
        "0": { "name": "keyword.other.errors.opalescent" }
      },
      "end": "(?==>)",
      "patterns": [
        { "include": "#type-name" },
        {
          "name": "punctuation.separator.comma.opalescent",
          "match": ","
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.declaration.opalescent",
          "match": "\\b(f|type|error|set|import|from|entry|public|pure|untested|using)\\b"
        },
        {
          "name": "keyword.operator.error-propagation.opalescent",
          "match": "\\bpropagate\\b"
        },
        {
          "name": "keyword.control.opalescent",
          "match": "\\b(if|else|while|for|in|loop|break|continue|return|guard|into)\\b"
        },
        {
          "name": "keyword.operator.word.opalescent",
          "match": "\\b(and|or|not|xor|band|bor|bxor|bnot|bshl|bshr|bushr|div_euclid|mod_euclid|is|as|type_of)\\b"
        },
        {
          "name": "keyword.other.opalescent",
          "match": "\\b(let|mutable|ref|new|with|errors)\\b"
        },
        {
          "name": "constant.language.boolean.opalescent",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.type.primitive.opalescent",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|boolean|string|void)\\b"
        }
      ]
    },
    "type-block": {
      "name": "meta.type.declaration.block.opalescent",
      "begin": "^\\s*(public\\s+)?(type)\\s+([A-Z][A-Za-z0-9_]*)\\b.*:$",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.visibility.opalescent" },
        "2": { "name": "keyword.declaration.type.opalescent" },
        "3": { "name": "entity.name.type.opalescent" }
      },
      "end": "^(?=\\S)|\\z",
      "patterns": [
        { "include": "#type-member" },
        { "include": "#line-comment" },
        { "include": "#type-name" }
      ]
    },
    "type-member": {
      "patterns": [
        {
          "name": "meta.type.member.variant.opalescent",
          "match": "^(\\s+)([A-Z][A-Za-z0-9_]*)(?=\\s*(?::|#|$))",
          "captures": {
            "2": { "name": "variable.other.property.opalescent variable.other.enummember.opalescent" }
          }
        },
        {
          "name": "meta.type.member.property.opalescent",
          "match": "^(\\s+)([a-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "captures": {
            "2": { "name": "variable.other.property.opalescent" }
          }
        }
      ]
    },
    "type-name": {
      "name": "entity.name.type.opalescent",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "function-call": {
      "name": "entity.name.function.opalescent",
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
    },
    "identifier": {
      "name": "variable.other.opalescent",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }
  }
}
