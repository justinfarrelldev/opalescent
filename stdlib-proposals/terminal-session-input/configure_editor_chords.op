# Proposal-only production chord example. It intentionally does not import standard.testing.terminal.
# See TESTING.md for synthetic-event coverage.
#
# Private compiler-checkable affine registrations used by this sketch are exact:
# - EditorChordRuntime owns, in one inseparable lifetime, TerminalChordRouter, EditorBindingMap,
#   the active MonotonicTimer and registration, EditorChordTimerRecoverySlot, and
#   EditorChordCapacityRecovery. Its sole cleanup operation is editor_chord_runtime_close,
#   with an explicit empty nominal cleanup-error set and explicit empty authority-transfer set.
# - EditorBindingMap has sole cleanup editor_binding_map_drop, with explicit empty cleanup-error
#   and transfer sets. It clears every application payload without touching router state.
# - EditorBindingMapPreparedEntry has sole cleanup editor_binding_map_prepared_entry_drop, with
#   an explicit empty cleanup-error set. Its only transfer is successful infallible
#   editor_binding_map_insert_prepared(...): void, which consumes the prepared owner and moves
#   its payload/storage into the runtime's map. Every non-success path retains its cleanup.
#
# editor_chord_runtime_new allocates and initializes the authenticated router, empty capacity
# recovery state, binding map, active timer/registration, and one disarmed pre-registered spare
# timer as one transaction. Allocation/registration failure rolls back in cleanup order and
# returns no owner. The returned runtime is Ready with a full spare slot.
# editor_chord_runtime_close consumes the runtime owner in one deterministic order. It first
# discards any pending recovery carrier/current event/output without applying, retrying, releasing,
# or activating it; then clears/drops the map, invokes terminal_chord_router_drop, and finally drops
# the spare and active timer registrations/timers. Explicit close consumes the using obligation;
# lexical cleanup is then a no-op. No operation consumes any field owner through ref or mutable ref.
#
# EditorChordCapacityRecovery is a fixed-size state field, never an independent owner. It has
# Empty, NeedRelease, NeedTimerSafety, NeedEventRetry, NeedOutputCompletion, and
# NeedSlotReplenishment phases. It stores values only, never references to runtime siblings.
# Stored next indices, output-timer-safe, and activation-applied bits make every explicit resume
# once-only. EditorChordTimerRecoverySlot owns exactly one disarmed pre-registered spare timer.
#
# Infallible private helpers perform field access/state transitions, map removal/lookup,
# activation effects, capacity capture/phase mutation, and spare swap. The two capacity apply
# helpers are fallible only with IndexOutOfBoundsError and retain their next index on failure;
# spare replenishment is fallible only with AllocationFailureError and retains
# NeedSlotReplenishment. These application-only declarations carry no terminal ABI and the
# router never stores an application payload, callback, closure, map node, or module object.

import monotonic_timer_arm, monotonic_timer_disarm, monotonic_timer_generation, monotonic_timer_readiness_source, terminal_capabilities_feature, terminal_chord_modifiers, terminal_chord_new, terminal_chord_with_lock_modifier_mask, terminal_chord_sequence_single, terminal_chord_sequence_append, terminal_chord_router_new, terminal_chord_router_register, terminal_chord_router_replace, terminal_chord_router_unregister, terminal_chord_router_process, terminal_chord_router_expire_sync, terminal_chord_router_reset, terminal_chord_released_input_length, terminal_chord_released_input_at from standard
import type AllocationFailureError, IndexOutOfBoundsError, MonotonicDeadline, MonotonicTimerError, SystemWaitSet, SystemWaitSetError, SystemWaitWake from standard
import type TerminalCapabilities, TerminalOrdinaryFeature, TerminalFeatureCapability, TerminalControlCode, TerminalFunctionKeyNumber, TerminalNamedKey, TerminalInputEvent, TerminalInputSequenceTimeoutMilliseconds from ./typed-event-session/typed_event_session.types
import type TerminalChordKey, TerminalChordTrigger, TerminalChordLogicalText, TerminalChord, TerminalLockModifierMask, TerminalChordSequence, TerminalChordTextPolicy, TerminalChordPrefixPolicy, TerminalChordRouterPolicy, TerminalChordRegistrationLimit, TerminalChordSequenceLengthLimit, TerminalChordBufferedEventLimit, TerminalChordPriority, TerminalChordBindingId, TerminalChordValidationError, TerminalChordMutationError, TerminalChordProcessError, TerminalChordMutationResult, TerminalChordRouterOutput, TerminalChordReleasedInput, TerminalChordResetReason from ./terminal_chords.types

let register_editor_binding = f(mutable ref runtime: EditorChordRuntime, sequence: TerminalChordSequence, priority: TerminalChordPriority, text_policy: TerminalChordTextPolicy, application_name: string): TerminalChordBindingId errors TerminalChordValidationError, AllocationFailureError =>
    # Allocate every application-owned node/payload byte before the router can commit.
    using prepared_entry = propagate editor_binding_map_prepare_entry(application_name):
        let binding_id = propagate terminal_chord_router_register(runtime.router, sequence, priority, text_policy)
        # No fallible operation intervenes. This declared transfer consumes prepared_entry.
        editor_binding_map_insert_prepared(runtime.binding_map, prepared_entry, binding_id)
        return binding_id

let apply_released_chord_input_once = f(input: TerminalChordReleasedInput): void errors IndexOutOfBoundsError =>
    let mutable index: int64 = 0
    let input_count = terminal_chord_released_input_length(input)
    while index < input_count:
        let event = propagate terminal_chord_released_input_at(input, index)
        apply_terminal_input_event_to_editor(event)
        index = index + 1
    return void

let arm_non_capacity_timer_or_mark_fail_closed = f(mutable ref runtime: EditorChordRuntime, deadline: MonotonicDeadline): void errors MonotonicTimerError =>
    guard monotonic_timer_arm(runtime.prefix_timer, deadline) into ignored_timer_generation else timer_error =>
        # The borrow never consumes the runtime. Its owner closes only after this call returns.
        editor_chord_runtime_mark_must_fail_close(runtime)
        propagate timer_error
    return void

let disarm_non_capacity_timer_or_mark_fail_closed = f(mutable ref runtime: EditorChordRuntime): void errors MonotonicTimerError =>
    guard monotonic_timer_disarm(runtime.prefix_timer) into ignored_timer_generation else timer_error =>
        editor_chord_runtime_mark_must_fail_close(runtime)
        propagate timer_error
    return void

let apply_released_input_then_disarm = f(input: TerminalChordReleasedInput, mutable ref runtime: EditorChordRuntime): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    guard apply_released_chord_input_once(input) else released_input_error =>
        propagate disarm_non_capacity_timer_or_mark_fail_closed(runtime)
        propagate released_input_error
    propagate disarm_non_capacity_timer_or_mark_fail_closed(runtime)
    return void

let replace_editor_binding = f(mutable ref runtime: EditorChordRuntime, binding_id: TerminalChordBindingId, replacement: TerminalChordSequence, priority: TerminalChordPriority, text_policy: TerminalChordTextPolicy): void errors TerminalChordValidationError, TerminalChordMutationError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    let result = propagate terminal_chord_router_replace(runtime.router, binding_id, replacement, priority, text_policy)
    if result is TerminalChordMutationResult.Replaced into replaced:
        # Replace preserves the ID, so the existing runtime map entry remains valid.
        propagate apply_released_input_then_disarm(replaced.released_input, runtime)
    return void

let unregister_editor_binding = f(mutable ref runtime: EditorChordRuntime, binding_id: TerminalChordBindingId): void errors TerminalChordMutationError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    let result = propagate terminal_chord_router_unregister(runtime.router, binding_id)
    if result is TerminalChordMutationResult.Unregistered into unregistered:
        # Router retirement commits first; infallible map removal follows only after success.
        editor_binding_map_remove(runtime.binding_map, unregistered.binding_id)
        propagate apply_released_input_then_disarm(unregistered.released_input, runtime)
    return void

let process_chord_router_output = f(output: TerminalChordRouterOutput, mutable ref runtime: EditorChordRuntime): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    if output is TerminalChordRouterOutput.Pending into pending:
        propagate arm_non_capacity_timer_or_mark_fail_closed(runtime, pending.deadline)
        return void
    if output is TerminalChordRouterOutput.AwaitingCorrelatedInput:
        propagate disarm_non_capacity_timer_or_mark_fail_closed(runtime)
        return void
    if output is TerminalChordRouterOutput.ReleasedInput into released:
        propagate apply_released_input_then_disarm(released.input, runtime)
        return void
    if output is TerminalChordRouterOutput.Activated into activated:
        activate_editor_binding_once(runtime.binding_map, activated.binding_id, activated.occurrence)
        propagate apply_released_input_then_disarm(activated.released_input, runtime)
        return void
    if output is TerminalChordRouterOutput.Idle:
        propagate disarm_non_capacity_timer_or_mark_fail_closed(runtime)
        return void
    return void

let ensure_capacity_timer_disarmed = f(mutable ref runtime: EditorChordRuntime): void errors MonotonicTimerError =>
    guard monotonic_timer_disarm(runtime.prefix_timer) into ignored_timer_generation else timer_error =>
        if timer_error is MonotonicTimerError.GenerationExhausted:
            # Infallible swap consumes the full spare field and replaces the active source identity.
            editor_chord_timer_recovery_slot_swap_exhausted(runtime)
            return void
        editor_chord_runtime_mark_must_fail_close(runtime)
        propagate timer_error
    return void

let ensure_capacity_timer_armed = f(mutable ref runtime: EditorChordRuntime, deadline: MonotonicDeadline): void errors MonotonicTimerError =>
    guard monotonic_timer_arm(runtime.prefix_timer, deadline) into ignored_timer_generation else timer_error =>
        if timer_error is MonotonicTimerError.GenerationExhausted:
            editor_chord_timer_recovery_slot_swap_exhausted(runtime)
            guard monotonic_timer_arm(runtime.prefix_timer, deadline) into replacement_generation else replacement_error =>
                editor_chord_runtime_mark_must_fail_close(runtime)
                propagate replacement_error cause timer_error
            return void
        editor_chord_runtime_mark_must_fail_close(runtime)
        propagate timer_error
    return void

let complete_capacity_retry_output = f(mutable ref runtime: EditorChordRuntime): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    let output = editor_chord_capacity_recovery_output(runtime.capacity_recovery)
    if output is TerminalChordRouterOutput.ReleasedInput:
        propagate editor_chord_capacity_recovery_apply_output_release_once(runtime.capacity_recovery)
    if output is TerminalChordRouterOutput.Activated:
        editor_chord_capacity_recovery_activate_output_once(runtime.capacity_recovery, runtime.binding_map)
        propagate editor_chord_capacity_recovery_apply_output_release_once(runtime.capacity_recovery)

    if editor_chord_capacity_recovery_output_needs_timer_safety(runtime.capacity_recovery):
        if output is TerminalChordRouterOutput.Pending into pending:
            propagate ensure_capacity_timer_armed(runtime, pending.deadline)
        else:
            propagate ensure_capacity_timer_disarmed(runtime)
        editor_chord_capacity_recovery_mark_output_timer_safe(runtime.capacity_recovery)

    editor_chord_capacity_recovery_mark_output_complete(runtime.capacity_recovery)
    return void

let resume_editor_chord_capacity_recovery = f(mutable ref runtime: EditorChordRuntime): void errors TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    if editor_chord_capacity_recovery_needs_release(runtime.capacity_recovery):
        # Indexed failure leaves the next index and every sibling owner in this runtime unchanged.
        propagate editor_chord_capacity_recovery_apply_capacity_release_once(runtime.capacity_recovery)
        editor_chord_capacity_recovery_mark_release_applied(runtime.capacity_recovery)

    if editor_chord_capacity_recovery_needs_timer_safety(runtime.capacity_recovery):
        propagate ensure_capacity_timer_disarmed(runtime)
        editor_chord_capacity_recovery_mark_timer_safe(runtime.capacity_recovery)

    if editor_chord_capacity_recovery_needs_event_retry(runtime.capacity_recovery):
        # Allocation failure leaves NeedEventRetry live. Any typed process rejection is an integrity failure.
        guard terminal_chord_router_process(runtime.router, editor_chord_capacity_recovery_event(runtime.capacity_recovery)) into retry_output else retry_error =>
            if retry_error is TerminalChordProcessError.BufferedCapacityExceeded:
                editor_chord_runtime_mark_must_fail_close(runtime)
            if retry_error is TerminalChordProcessError.WrongInputStream:
                editor_chord_runtime_mark_must_fail_close(runtime)
            if retry_error is TerminalChordProcessError.DeliveryAlreadyConsumed:
                editor_chord_runtime_mark_must_fail_close(runtime)
            if retry_error is TerminalChordProcessError.DeliveryOutOfOrder:
                editor_chord_runtime_mark_must_fail_close(runtime)
            propagate retry_error
        editor_chord_capacity_recovery_store_accepted_output(runtime.capacity_recovery, retry_output)

    if editor_chord_capacity_recovery_needs_output_completion(runtime.capacity_recovery):
        propagate complete_capacity_retry_output(runtime)

    if editor_chord_capacity_recovery_needs_slot_replenishment(runtime.capacity_recovery):
        # Allocation failure retains only NeedSlotReplenishment; completed effects never replay.
        propagate editor_chord_timer_recovery_slot_replenish_sync(runtime.timer_recovery_slot)
        editor_chord_capacity_recovery_finish(runtime.capacity_recovery)
    return void

let process_editor_chord_event = f(mutable ref runtime: EditorChordRuntime, event: TerminalInputEvent): void errors TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    # Fresh events are legal only in Ready/Empty. Recovering and MustFailClose reject before routing.
    editor_chord_runtime_require_ready(runtime)
    guard terminal_chord_router_process(runtime.router, event) into output else process_error =>
        if process_error is TerminalChordProcessError.BufferedCapacityExceeded into capacity:
            # Fixed-size capture moves release and current event into the co-owned obligation.
            editor_chord_capacity_recovery_capture(runtime.capacity_recovery, capacity.released_input, event)
            propagate resume_editor_chord_capacity_recovery(runtime)
            return void
        propagate process_error
    propagate process_chord_router_output(output, runtime)
    return void

let expire_editor_chord_prefix_after_timer_wake = f(mutable ref runtime: EditorChordRuntime, wake: SystemWaitWake): void errors AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    editor_chord_runtime_require_ready(runtime)
    if wake is SystemWaitWake.Cancelled:
        return void
    if wake is SystemWaitWake.Ready into ready:
        let timer_source = monotonic_timer_readiness_source(runtime.prefix_timer)
        if ready.source is not timer_source:
            return void
        if ready.generation is not monotonic_timer_generation(runtime.prefix_timer):
            return void
        let output = propagate terminal_chord_router_expire_sync(runtime.router)
        propagate process_chord_router_output(output, runtime)
    return void

let reset_editor_chord_router = f(mutable ref runtime: EditorChordRuntime): void errors AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    editor_chord_runtime_require_ready(runtime)
    let released = propagate terminal_chord_router_reset(runtime.router, new TerminalChordResetReason.ApplicationRequested)
    propagate apply_released_input_then_disarm(released, runtime)
    return void

let register_editor_chords = f(mutable ref runtime: EditorChordRuntime, capabilities: TerminalCapabilities): void errors TerminalChordValidationError, AllocationFailureError =>
    let no_modifiers = terminal_chord_modifiers(false, false, false, false)
    let control_modifiers = terminal_chord_modifiers(false, true, false, false)

    let control_key = new TerminalChordKey.Control:
        code: 17 as TerminalControlCode
    let control_chord = terminal_chord_new(control_key, control_modifiers, new TerminalChordTrigger.PressOrRepeat)
    let control_sequence = propagate terminal_chord_sequence_single(control_chord)
    let quit_binding = propagate register_editor_binding(runtime, control_sequence, 100 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'quit')

    let named_key = new TerminalChordKey.Named:
        key: new TerminalNamedKey.Escape
    let named_chord = terminal_chord_new(named_key, no_modifiers, new TerminalChordTrigger.Press)
    let escape_sequence = propagate terminal_chord_sequence_single(named_chord)
    let escape_binding = propagate register_editor_binding(runtime, escape_sequence, 90 as TerminalChordPriority, new TerminalChordTextPolicy.PreserveLinkedText, 'escape')

    let function_key = new TerminalChordKey.Function:
        number: 4 as TerminalFunctionKeyNumber
    let function_chord = terminal_chord_new(function_key, no_modifiers, new TerminalChordTrigger.Press)
    let lock_sensitive_function = terminal_chord_with_lock_modifier_mask(function_chord, new TerminalLockModifierMask.MatchAllLocks)
    let function_sequence = propagate terminal_chord_sequence_single(lock_sensitive_function)
    let function_binding = propagate register_editor_binding(runtime, function_sequence, 80 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'function-four')

    let enhanced_capability = terminal_capabilities_feature(capabilities, new TerminalOrdinaryFeature.EnhancedKeyIdentity)
    if enhanced_capability is TerminalFeatureCapability.Enabled:
        let enhanced_key = new TerminalChordKey.EnhancedText:
            logical_text: 'x' as TerminalChordLogicalText
        let enhanced_chord = terminal_chord_new(enhanced_key, no_modifiers, new TerminalChordTrigger.Press)
        let enhanced_sequence = propagate terminal_chord_sequence_single(enhanced_chord)
        let enhanced_binding = propagate register_editor_binding(runtime, enhanced_sequence, 70 as TerminalChordPriority, new TerminalChordTextPolicy.PreserveLinkedText, 'enhanced-x')

    let sequence = propagate terminal_chord_sequence_append(escape_sequence, function_chord)
    let sequence_binding = propagate register_editor_binding(runtime, sequence, 60 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'escape-then-function-four')
    return void

let run_chord_router_example = f(mutable ref wait_set: SystemWaitSet, capabilities: TerminalCapabilities, event: TerminalInputEvent, timer_wake: SystemWaitWake): void errors SystemWaitSetError, TerminalChordValidationError, TerminalChordMutationError, TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    let policy = new TerminalChordRouterPolicy:
        prefix_policy: new TerminalChordPrefixPolicy.LongestThenPriority
        sequence_timeout: 750 as TerminalInputSequenceTimeoutMilliseconds
        maximum_registrations: 128 as TerminalChordRegistrationLimit
        maximum_sequence_length: 8 as TerminalChordSequenceLengthLimit
        maximum_buffered_events: 64 as TerminalChordBufferedEventLimit

    # Construction authenticates capabilities and co-owns every state required for recovery.
    using runtime = propagate editor_chord_runtime_new(wait_set, capabilities, policy):
        propagate register_editor_chords(runtime, capabilities)

        guard process_editor_chord_event(runtime, event) else operation_error =>
            if editor_chord_runtime_must_fail_close(runtime):
                # The consuming close runs only after the mutable borrow has ended.
                editor_chord_runtime_close(runtime)
                propagate operation_error
            if editor_chord_runtime_capacity_recovery_pending(runtime):
                # One explicit resume demonstrates that the same live owner preserves retry state.
                guard resume_editor_chord_capacity_recovery(runtime) else resume_error =>
                    if editor_chord_runtime_must_fail_close(runtime):
                        editor_chord_runtime_close(runtime)
                        propagate resume_error cause operation_error
                    # A retryable error remains in its exact phase until this scope either resumes
                    # again or exits; lexical cleanup then consumes obligation and sibling owners.
                    propagate resume_error cause operation_error
            else:
                propagate operation_error

        guard expire_editor_chord_prefix_after_timer_wake(runtime, timer_wake) else expiration_error =>
            if editor_chord_runtime_must_fail_close(runtime):
                editor_chord_runtime_close(runtime)
            propagate expiration_error

        guard reset_editor_chord_router(runtime) else reset_error =>
            if editor_chord_runtime_must_fail_close(runtime):
                editor_chord_runtime_close(runtime)
            propagate reset_error
    return void
