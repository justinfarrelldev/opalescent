# Proposal-only production chord example. It intentionally does not import standard.testing.terminal.
# See TESTING.md for synthetic-event coverage.
# Application-owned, infallible placeholders used below: editor_binding_map_insert, editor_binding_map_remove,
# activate_editor_binding_once, apply_terminal_input_event_to_editor, and the editor_chord_capacity_recovery_*
# phase/access helpers. EditorChordCapacityRecovery is one private fixed-size affine slot with Empty,
# NeedRelease, NeedTimerSafety, NeedEventRetry, NeedOutputCompletion, and NeedSlotReplenishment phases.
# Capture moves one released carrier and the still-caller-owned event into an Empty slot without allocation.
# The object stores one next-release index per carrier, one output-timer-safe bit, and one activation-applied bit;
# its application helpers advance those fields after each successful side effect, so resumption never reapplies input,
# timer work, or activation. Each phase helper is valid only for its named phase and advances at most once.
# EditorChordTimerRecoverySlot
# owns exactly one disarmed spare MonotonicTimer whose readiness source is already registered with the same
# application wait set. editor_chord_timer_recovery_slot_swap_exhausted is infallible: it drops the exhausted
# timer and registration, moves the spare into the active position, and consumes the spare slot. The fallible
# replenish helper fills only an empty spare slot and must succeed before normal router or wait handling resumes.
# These application-only types and helpers are neither terminal APIs nor production ABI declarations.

import monotonic_timer_arm, monotonic_timer_disarm, monotonic_timer_generation, monotonic_timer_readiness_source, terminal_capabilities_feature, terminal_chord_modifiers, terminal_chord_new, terminal_chord_with_lock_modifier_mask, terminal_chord_sequence_single, terminal_chord_sequence_append, terminal_chord_router_new, terminal_chord_router_register, terminal_chord_router_replace, terminal_chord_router_unregister, terminal_chord_router_process, terminal_chord_router_expire_sync, terminal_chord_router_reset, terminal_chord_released_input_length, terminal_chord_released_input_at from standard
import type AllocationFailureError, IndexOutOfBoundsError, MonotonicDeadline, MonotonicTimer, MonotonicTimerError, SystemWaitWake from standard
import type TerminalCapabilities, TerminalOrdinaryFeature, TerminalFeatureCapability, TerminalControlCode, TerminalFunctionKeyNumber, TerminalNamedKey, TerminalInputEvent, TerminalInputSequenceTimeoutMilliseconds, TerminalCorrelatedEventLimit from ./typed-event-session/typed_event_session.types
import type TerminalChordKey, TerminalChordTrigger, TerminalChordLogicalText, TerminalChord, TerminalLockModifierMask, TerminalChordSequence, TerminalChordTextPolicy, TerminalChordPrefixPolicy, TerminalChordRouterPolicy, TerminalChordRegistrationLimit, TerminalChordSequenceLengthLimit, TerminalChordBufferedEventLimit, TerminalChordPriority, TerminalChordBindingId, TerminalChordValidationError, TerminalChordMutationError, TerminalChordProcessError, TerminalChordMutationResult, TerminalChordRouter, TerminalChordRouterOutput, TerminalChordReleasedInput, TerminalChordResetReason from ./terminal_chords.types

let register_editor_binding = f(mutable ref router: TerminalChordRouter, sequence: TerminalChordSequence, priority: TerminalChordPriority, text_policy: TerminalChordTextPolicy, application_name: string): TerminalChordBindingId errors TerminalChordValidationError, AllocationFailureError =>
    let binding_id = propagate terminal_chord_router_register(router, sequence, priority, text_policy)
    # The application map changes only after registration returned this live router-bound ID.
    editor_binding_map_insert(binding_id, application_name)
    return binding_id

let apply_released_chord_input_once = f(input: TerminalChordReleasedInput): void errors IndexOutOfBoundsError =>
    let mutable index: int64 = 0
    let input_count = terminal_chord_released_input_length(input)
    while index < input_count:
        let event = propagate terminal_chord_released_input_at(input, index)
        apply_terminal_input_event_to_editor(event)
        index = index + 1
    return void

let apply_released_input_then_disarm = f(input: TerminalChordReleasedInput, mutable ref prefix_timer: MonotonicTimer): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    guard apply_released_chord_input_once(input) else released_input_error =>
        let ignored_timer_generation = propagate monotonic_timer_disarm(prefix_timer)
        propagate released_input_error
    let ignored_timer_generation = propagate monotonic_timer_disarm(prefix_timer)
    return void

let finish_successful_chord_mutation = f(input: TerminalChordReleasedInput, mutable ref prefix_timer: MonotonicTimer): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    # Router success has already atomically changed router state. Deliver once, then disarm before later router or wait work.
    propagate apply_released_input_then_disarm(input, prefix_timer)
    return void

let replace_editor_binding = f(mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer, binding_id: TerminalChordBindingId, replacement: TerminalChordSequence, priority: TerminalChordPriority, text_policy: TerminalChordTextPolicy): void errors TerminalChordValidationError, TerminalChordMutationError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    # BindingNotFound, WrongRouter, CorrelatedGroupPending, validation, and allocation failures leave router, map, and timer unchanged.
    let result = propagate terminal_chord_router_replace(router, binding_id, replacement, priority, text_policy)
    if result is TerminalChordMutationResult.Replaced into replaced:
        # Replace preserves the ID, so its existing application map entry remains valid.
        propagate finish_successful_chord_mutation(replaced.released_input, prefix_timer)
    return void

let unregister_editor_binding = f(mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer, binding_id: TerminalChordBindingId): void errors TerminalChordMutationError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    # BindingNotFound, WrongRouter, CorrelatedGroupPending, and allocation failures leave router, map, and timer unchanged.
    let result = propagate terminal_chord_router_unregister(router, binding_id)
    if result is TerminalChordMutationResult.Unregistered into unregistered:
        # The router has retired this ID, so only now may the application remove its external entry.
        editor_binding_map_remove(unregistered.binding_id)
        propagate finish_successful_chord_mutation(unregistered.released_input, prefix_timer)
    return void

let process_chord_router_output = f(output: TerminalChordRouterOutput, mutable ref prefix_timer: MonotonicTimer): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    if output is TerminalChordRouterOutput.Pending into pending:
        # A resolvable prefix provides the exact core-owned deadline to arm on the separate caller timer.
        let ignored_timer_generation = propagate monotonic_timer_arm(prefix_timer, pending.deadline)
        return void
    if output is TerminalChordRouterOutput.AwaitingCorrelatedInput:
        # Incomplete linked text has no timeout and may not be split.
        let ignored_timer_generation = propagate monotonic_timer_disarm(prefix_timer)
        return void
    if output is TerminalChordRouterOutput.ReleasedInput into released:
        propagate apply_released_input_then_disarm(released.input, prefix_timer)
        return void
    if output is TerminalChordRouterOutput.Activated into activated:
        activate_editor_binding_once(activated.binding_id, activated.occurrence)
        propagate apply_released_input_then_disarm(activated.released_input, prefix_timer)
        return void
    if output is TerminalChordRouterOutput.Idle:
        # No current router deadline: ensure no caller timer remains armed.
        let ignored_timer_generation = propagate monotonic_timer_disarm(prefix_timer)
        return void
    return void

let ensure_capacity_timer_disarmed = f(mutable ref prefix_timer: MonotonicTimer, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot): void errors MonotonicTimerError =>
    guard monotonic_timer_disarm(prefix_timer) into ignored_timer_generation else timer_error =>
        if timer_error is MonotonicTimerError.GenerationExhausted:
            # The pre-registered spare becomes active; every old-source wake is stale by source identity.
            editor_chord_timer_recovery_slot_swap_exhausted(prefix_timer, timer_recovery_slot)
            return void
        propagate timer_error
    return void

let ensure_capacity_timer_armed = f(mutable ref prefix_timer: MonotonicTimer, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot, deadline: MonotonicDeadline): void errors MonotonicTimerError =>
    guard monotonic_timer_arm(prefix_timer, deadline) into ignored_timer_generation else timer_error =>
        if timer_error is MonotonicTimerError.GenerationExhausted:
            editor_chord_timer_recovery_slot_swap_exhausted(prefix_timer, timer_recovery_slot)
            let replacement_generation = propagate monotonic_timer_arm(prefix_timer, deadline)
            return void
        propagate timer_error
    return void

let complete_capacity_retry_output = f(mutable ref recovery: EditorChordCapacityRecovery, mutable ref prefix_timer: MonotonicTimer, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot): void errors IndexOutOfBoundsError, MonotonicTimerError =>
    let output = editor_chord_capacity_recovery_output(recovery)
    if output is TerminalChordRouterOutput.ReleasedInput:
        # The recovery object retains its next index, so an accessor failure cannot duplicate an earlier application.
        propagate editor_chord_capacity_recovery_apply_output_release_once(recovery)
    if output is TerminalChordRouterOutput.Activated:
        editor_chord_capacity_recovery_activate_output_once(recovery)
        propagate editor_chord_capacity_recovery_apply_output_release_once(recovery)

    if editor_chord_capacity_recovery_output_needs_timer_safety(recovery):
        if output is TerminalChordRouterOutput.Pending into pending:
            propagate ensure_capacity_timer_armed(prefix_timer, timer_recovery_slot, pending.deadline)
        else:
            propagate ensure_capacity_timer_disarmed(prefix_timer, timer_recovery_slot)
        editor_chord_capacity_recovery_mark_output_timer_safe(recovery)

    editor_chord_capacity_recovery_mark_output_complete(recovery)
    return void

let resume_editor_chord_capacity_recovery = f(mutable ref recovery: EditorChordCapacityRecovery, mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot): void errors TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    if editor_chord_capacity_recovery_needs_release(recovery):
        # The stored next index makes partial failure resumable without duplicating an earlier application.
        propagate editor_chord_capacity_recovery_apply_capacity_release_once(recovery)
        editor_chord_capacity_recovery_mark_release_applied(recovery)

    if editor_chord_capacity_recovery_needs_timer_safety(recovery):
        propagate ensure_capacity_timer_disarmed(prefix_timer, timer_recovery_slot)
        editor_chord_capacity_recovery_mark_timer_safe(recovery)

    if editor_chord_capacity_recovery_needs_event_retry(recovery):
        # The empty-buffer retry cannot overflow. Allocation failure leaves this exact phase and event owned here.
        let retry_output = propagate terminal_chord_router_process(router, editor_chord_capacity_recovery_event(recovery))
        editor_chord_capacity_recovery_store_accepted_output(recovery, retry_output)

    if editor_chord_capacity_recovery_needs_output_completion(recovery):
        propagate complete_capacity_retry_output(recovery, prefix_timer, timer_recovery_slot)

    if editor_chord_capacity_recovery_needs_slot_replenishment(recovery):
        # Failure keeps normal router/wait handling fail-closed; completed release and accepted event are not repeated.
        propagate editor_chord_timer_recovery_slot_replenish_sync(timer_recovery_slot)
        editor_chord_capacity_recovery_finish(recovery)
    return void

let process_editor_chord_event = f(mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer, mutable ref capacity_recovery: EditorChordCapacityRecovery, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot, event: TerminalInputEvent): void errors TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    # This fresh-event entry requires Empty; a pending obligation is resumed through the helper above instead.
    editor_chord_capacity_recovery_require_empty(capacity_recovery)
    guard terminal_chord_router_process(router, event) into output else process_error =>
        if process_error is TerminalChordProcessError.BufferedCapacityExceeded into capacity:
            # Fixed-size capture cannot allocate and moves both obligations before any fallible recovery step.
            editor_chord_capacity_recovery_capture(capacity_recovery, capacity.released_input, event)
            propagate resume_editor_chord_capacity_recovery(capacity_recovery, router, prefix_timer, timer_recovery_slot)
            return void
        propagate process_error
    propagate process_chord_router_output(output, prefix_timer)
    return void

let expire_editor_chord_prefix_after_timer_wake = f(mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer, wake: SystemWaitWake): void errors AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    # Cancelled carries no timer metadata and must not expire or otherwise change chord state.
    if wake is SystemWaitWake.Cancelled:
        return void
    if wake is SystemWaitWake.Ready into ready:
        # A Ready wake must identify this caller timer before its generation is considered.
        let timer_source = monotonic_timer_readiness_source(prefix_timer)
        if ready.source is not timer_source:
            return void
        if ready.generation is not monotonic_timer_generation(prefix_timer):
            return void
        let output = propagate terminal_chord_router_expire_sync(router)
        propagate process_chord_router_output(output, prefix_timer)
    return void

let reset_editor_chord_router = f(mutable ref router: TerminalChordRouter, mutable ref prefix_timer: MonotonicTimer): void errors AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    let released = propagate terminal_chord_router_reset(router, new TerminalChordResetReason.ApplicationRequested)
    # Reset release is handled once, then caller timer is disarmed before later routing or waiting.
    propagate apply_released_input_then_disarm(released, prefix_timer)
    return void

let register_editor_chords = f(mutable ref router: TerminalChordRouter, capabilities: TerminalCapabilities): void errors TerminalChordValidationError, AllocationFailureError =>
    let no_modifiers = terminal_chord_modifiers(false, false, false, false)
    let control_modifiers = terminal_chord_modifiers(false, true, false, false)

    let control_key = new TerminalChordKey.Control:
        code: 17 as TerminalControlCode
    let control_chord = terminal_chord_new(control_key, control_modifiers, new TerminalChordTrigger.PressOrRepeat)
    let control_sequence = propagate terminal_chord_sequence_single(control_chord)
    let quit_binding = propagate register_editor_binding(router, control_sequence, 100 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'quit')

    let named_key = new TerminalChordKey.Named:
        key: new TerminalNamedKey.Escape
    let named_chord = terminal_chord_new(named_key, no_modifiers, new TerminalChordTrigger.Press)
    let escape_sequence = propagate terminal_chord_sequence_single(named_chord)
    let escape_binding = propagate register_editor_binding(router, escape_sequence, 90 as TerminalChordPriority, new TerminalChordTextPolicy.PreserveLinkedText, 'escape')

    let function_key = new TerminalChordKey.Function:
        number: 4 as TerminalFunctionKeyNumber
    let function_chord = terminal_chord_new(function_key, no_modifiers, new TerminalChordTrigger.Press)
    let lock_sensitive_function = terminal_chord_with_lock_modifier_mask(function_chord, new TerminalLockModifierMask.MatchAllLocks)
    let function_sequence = propagate terminal_chord_sequence_single(lock_sensitive_function)
    let function_binding = propagate register_editor_binding(router, function_sequence, 80 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'function-four')

    let enhanced_capability = terminal_capabilities_feature(capabilities, new TerminalOrdinaryFeature.EnhancedKeyIdentity)
    if enhanced_capability is TerminalFeatureCapability.Enabled:
        let enhanced_key = new TerminalChordKey.EnhancedText:
            logical_text: 'x' as TerminalChordLogicalText
        let enhanced_chord = terminal_chord_new(enhanced_key, no_modifiers, new TerminalChordTrigger.Press)
        let enhanced_sequence = propagate terminal_chord_sequence_single(enhanced_chord)
        let enhanced_binding = propagate register_editor_binding(router, enhanced_sequence, 70 as TerminalChordPriority, new TerminalChordTextPolicy.PreserveLinkedText, 'enhanced-x')

    let sequence = propagate terminal_chord_sequence_append(escape_sequence, function_chord)
    let sequence_binding = propagate register_editor_binding(router, sequence, 60 as TerminalChordPriority, new TerminalChordTextPolicy.SuppressLinkedText, 'escape-then-function-four')
    return void

let run_chord_router_example = f(capabilities: TerminalCapabilities, event: TerminalInputEvent, mutable ref prefix_timer: MonotonicTimer, mutable ref capacity_recovery: EditorChordCapacityRecovery, mutable ref timer_recovery_slot: EditorChordTimerRecoverySlot, timer_wake: SystemWaitWake): void errors TerminalChordValidationError, TerminalChordMutationError, TerminalChordProcessError, AllocationFailureError, IndexOutOfBoundsError, MonotonicTimerError =>
    let policy = new TerminalChordRouterPolicy:
        prefix_policy: new TerminalChordPrefixPolicy.LongestThenPriority
        sequence_timeout: 750 as TerminalInputSequenceTimeoutMilliseconds
        maximum_registrations: 128 as TerminalChordRegistrationLimit
        maximum_sequence_length: 8 as TerminalChordSequenceLengthLimit
        maximum_buffered_events: 64 as TerminalChordBufferedEventLimit

    # This exact value matches the selected session options that produced event.
    let maximum_correlated_events = 64 as TerminalCorrelatedEventLimit
    using router = propagate terminal_chord_router_new(capabilities, policy, maximum_correlated_events):
        propagate register_editor_chords(router, capabilities)
        propagate process_editor_chord_event(router, prefix_timer, capacity_recovery, timer_recovery_slot, event)
        # A propagated recovery error prevents this stale-wake path; success guarantees an Empty obligation and full spare slot.
        propagate expire_editor_chord_prefix_after_timer_wake(router, prefix_timer, timer_wake)
        propagate reset_editor_chord_router(router, prefix_timer)
    return void
