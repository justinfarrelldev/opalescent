##
@abi_type_id(0x540000000000010e)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public constrained type TerminalChordBindingId: uint64 where value >= 1

##
  Description: Is an immutable bounded application-built sequence of TerminalChord values.
  Evolution: Closed; representation changes require an ABI-major release.
##
@abi_type_id(0x540000000000010f)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public opaque immutable type TerminalChordSequence

##
  Description: Is immutable input released by the router in original normalized event order.
  Evolution: Closed; representation changes require an ABI-major release.
##
@abi_type_id(0x5400000000000110)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public opaque immutable type TerminalChordReleasedInput

##
  Description: Reports one router processing step, including activation and any released input.
  Invariant: At most one Activated value is produced per normalized Key event; occurrence preserves its exact count.
  Evolution: Closed; processing semantics change only in an ABI-major release.
##
@abi_type_id(0x5400000000000111)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public type TerminalChordRouterOutput:
    Pending = 1
    ReleasedInput = 2:
        input: TerminalChordReleasedInput
    Activated = 3:
        binding_id: TerminalChordBindingId
        occurrence: TerminalKeyOccurrence
        released_input: TerminalChordReleasedInput

##
  Description: Reports stable structured chord registration failures.
  Evolution: Closed; validation semantics change only in an ABI-major release.
##
@abi_type_id(0x5400000000000112)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public type TerminalChordValidationError:
    EmptySequence = 1
    SequenceTooLong = 2:
        configured_limit: TerminalChordSequenceLengthLimit
    RegistrationLimitReached = 3:
        configured_limit: TerminalChordRegistrationLimit
    DuplicateBinding = 4:
        existing_binding_id: TerminalChordBindingId
    PrefixAmbiguity = 5:
        existing_binding_id: TerminalChordBindingId
    EnhancedKeyIdentityRequired = 6
    ReleaseEventsRequired = 7
    BindingIdentifierExhausted = 8

##
  Description: Owns bounded registration, prefix, and correlated-input buffering state.
  Invariant: Affine destruction is deterministic and infallibly releases buffered immutable input and registrations.
  Evolution: Closed; ownership semantics change only in an ABI-major release.
##
@abi_type_id(0x5400000000000113)
@abi_evolution(closed_major_only)
@constructor_visibility(standard_library)
public compiler_registered affine resource type TerminalChordRouter
