# Proposal-only type declarations. This .types.op file intentionally contains only type declarations and remains noncompiling until proposal syntax fixtures pass.
# Constraint expressions may call compiler intrinsics such as contains_no_nul(value), utf8_byte_length(value), and unicode_scalar_count(value).
# Those intrinsics are not public declarations, values, imports, or callable application APIs.
# @abi_type_id, @abi_evolution, @constructor_visibility, opaque immutable, and affine resource are proposed syntax.

##
  Description: Represents a valid legacy terminal control code.
  Range: 0..31 or 127.
##
@abi_type_id(0x5400000000000010)
@abi_evolution(closed_major_only)
public constrained type TerminalControlCode: uint8 where value <= 31 or value is 127

##
  Description: Identifies a function key.
  Range: 1..32767.
##
@abi_type_id(0x5400000000000011)
@abi_evolution(closed_major_only)
public constrained type TerminalFunctionKeyNumber: int32 where value >= 1 and value <= 32767

