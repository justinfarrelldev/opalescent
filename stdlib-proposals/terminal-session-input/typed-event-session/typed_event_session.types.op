        diagnostic: TerminalDiagnostic
    UnsupportedFeature = 5:
        feature: TerminalFeature
        diagnostic: TerminalDiagnostic
    ModeReadFailed = 6:
        diagnostic: TerminalDiagnostic
    ModeWriteFailed = 7:
        diagnostic: TerminalDiagnostic
    AllocationFailed = 8:
        diagnostic: TerminalDiagnostic
    RollbackFailed = 9:
